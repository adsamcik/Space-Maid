<Window x:Class="SpaceMaid.Extensions.Agents.AgentHistoryPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review agent history cleanup" Width="740" Height="590" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Move these history files to the Recycle Bin?" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" Margin="0,8" />
            <TextBlock Text="Removing transcripts loses session resumption and conversation context. Only the listed files move. App indexes and related task files remain, so history entries may still appear. Restore files from the Recycle Bin if needed; agent app recovery is not guaranteed." TextWrapping="Wrap" />
            <TextBlock Text="Files continue occupying disk space until the Recycle Bin is emptied. Age is based on the last file change and does not establish that a session is finished." TextWrapping="Wrap" Margin="0,8,0,10" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Confirmed agent history paths">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,5"><TextBlock Text="{Binding Path}" TextWrapping="Wrap" /><TextBlock Opacity="0.7"><Run Text="{Binding Tool, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" /></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <CheckBox Grid.Row="2" x:Name="StoppedAcknowledgement" Margin="0,12,0,0" Checked="Acknowledgement_Changed" Unchecked="Acknowledgement_Changed">
            <TextBlock Text="I closed all clients using these agent homes and preserved the history I need." TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,10,0" />
            <Button x:Name="RecycleButton" Content="Move files to Recycle Bin" IsEnabled="False" Click="Recycle_Click" />
        </StackPanel>
    </Grid>
</Window>
