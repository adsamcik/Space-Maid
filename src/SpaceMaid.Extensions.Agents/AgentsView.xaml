<UserControl x:Class="SpaceMaid.Extensions.Agents.AgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel>
            <Button x:Name="InspectButton" DockPanel.Dock="Right" Content="Inspect history" Click="Inspect_Click" Margin="12,0,0,0" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" Margin="8,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ToolPicker" SelectedIndex="0" Width="165" SelectionChanged="Source_Changed" AutomationProperties.Name="Agent history source">
                    <ComboBoxItem Content="Standard homes" /><ComboBoxItem Content="Codex" /><ComboBoxItem Content="Claude Code" /><ComboBoxItem Content="Gemini CLI" />
                </ComboBox>
                <TextBlock Text="Last changed at least" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="AgeBox" Text="30" Width="55" VerticalContentAlignment="Center" AutomationProperties.Name="History age in days" TextChanged="Age_Changed" />
                <TextBlock Text="days ago" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" x:Name="HomeRow" Visibility="Collapsed" Margin="0,8,0,0">
            <Button Content="Choose home…" DockPanel.Dock="Right" Click="Browse_Click" Margin="8,0,0,0" />
            <TextBox x:Name="HomeBox" AutomationProperties.Name="Agent home folder" TextChanged="Home_Changed" />
        </DockPanel>
        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Inspect old transcripts and diagnostic logs. Nothing is selected automatically." Margin="0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <DataGrid Grid.Row="3" x:Name="HistoryList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Selection_Changed" EnableRowVirtualization="True" HeadersVisibility="Column" RowHeight="38" AutomationProperties.Name="Old agent history files">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Agent" Binding="{Binding Tool}" Width="100" />
                <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="3*" MinWidth="160" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130" />
                <DataGridTextColumn Header="Last changed" Binding="{Binding LastChanged, StringFormat={}{0:g}}" Width="145" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="105" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="DetailsText" Text="Choose files to review. Age identifies candidates; it does not prove they are unused." TextWrapping="Wrap" />
            <Button x:Name="ReviewButton" Content="Review cleanup…" IsEnabled="False" Click="Review_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <Expander Header="Scope and inspection details" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Recycles selected transcript or log files only. App indexes, related task files, memory, checkpoints and credentials are kept. History entries may remain in the agent app; related files may still use space." TextWrapping="Wrap" Margin="0,4" />
                    <TextBox x:Name="DiagnosticText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
