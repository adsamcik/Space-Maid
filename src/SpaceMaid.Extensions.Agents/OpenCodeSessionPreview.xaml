<Window x:Class="SpaceMaid.Extensions.Agents.OpenCodeSessionPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review OpenCode session cleanup" Width="700" Height="610" MinWidth="510" MinHeight="510"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Permanently remove this OpenCode session?" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Session.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Session ID" Opacity="0.7" /><TextBox Text="{Binding Session.Id, Mode=OneWay}" IsReadOnly="True" Margin="0,3,0,8" />
                <TextBlock Text="Project folder" Opacity="0.7" /><TextBox Text="{Binding Session.Directory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,3,0,8" />
                <TextBlock Text="{Binding Session.LastChanged, StringFormat='Last changed: {0:g}'}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Endpoint}" Margin="0,0,0,8" />
                <TextBlock Text="OpenCode permanently deletes this session and its stored conversation data. This bypasses the Recycle Bin. Preserve useful history before confirming. It was idle, unshared and had no parent or children when checked; those checks run again before deletion. Session families stay together to preserve active work and recovery context." TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="Activity reflects this server; other OpenCode instances may use the same store. Pause all clients and automation using this session. OpenCode cannot atomically check idle state and delete, so another client could resume it after the check. No work is automatically aborted here." TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="Reclaimable host disk space is unknown. SQLite can retain free pages inside the database after deletion; the database is not compacted or removed." TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <CheckBox Grid.Row="2" x:Name="PausedAcknowledgement" Margin="0,12,0,0" Checked="Acknowledgement_Changed" Unchecked="Acknowledgement_Changed">
            <TextBlock Text="I paused clients and automation using this session and preserved the history I need." TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,10,0" />
            <Button x:Name="DeleteButton" Content="Delete session permanently" IsEnabled="False" Click="Delete_Click" />
        </StackPanel>
    </Grid>
</Window>
