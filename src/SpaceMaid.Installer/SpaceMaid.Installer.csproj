<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>../../assets/branding/space-maid-visor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="../../assets/branding/space-maid-visor.ico" Link="Assets/SpaceMaid.ico" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="SpaceMaid.Installer.Notices.SpaceMaid.LICENSE" />
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md" LogicalName="SpaceMaid.Installer.Notices.SpaceMaid.THIRD_PARTY_NOTICES.md" />
    <InternalsVisibleTo Include="SpaceMaid.Tests" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SetupSha256</_Parameter1><_Parameter2>$(InstallerSetupSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PortableSha256</_Parameter1><_Parameter2>$(InstallerPortableSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateSha256</_Parameter1><_Parameter2>$(InstallerUpdateSha256)</_Parameter2>
    </AssemblyAttribute>
    <EmbeddedResource Include="$(InstallerSetupPayload)" LogicalName="SpaceMaid.Installer.Payload.Setup.exe" Condition="'$(InstallerSetupPayload)' != ''" />
    <EmbeddedResource Include="$(InstallerPortablePayload)" LogicalName="SpaceMaid.Installer.Payload.Portable.zip" Condition="'$(InstallerPortablePayload)' != ''" />
    <EmbeddedResource Include="$(InstallerUpdatePayload)" LogicalName="SpaceMaid.Installer.Payload.Update.nupkg" Condition="'$(InstallerUpdatePayload)' != ''" />
  </ItemGroup>
  <Target Name="ValidateInstallerPayloads" BeforeTargets="PrepareForBuild" Condition="'$(InstallerSetupPayload)' != '' or '$(InstallerPortablePayload)' != '' or '$(InstallerUpdatePayload)' != ''">
    <Error Condition="!Exists('$(InstallerSetupPayload)') or !Exists('$(InstallerPortablePayload)') or !Exists('$(InstallerUpdatePayload)')" Text="Native Setup, portable ZIP and full update package payloads are required." />
    <Error Condition="'$(InstallerSetupSha256)' == '' or '$(InstallerPortableSha256)' == '' or '$(InstallerUpdateSha256)' == ''" Text="Installer payload SHA-256 values are required." />
  </Target>
  <Target Name="EmbedInstallerRuntimeNotices" AfterTargets="ResolveFrameworkReferences" BeforeTargets="PrepareResourceNames" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_InstallerCoreRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_InstallerDesktopRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
      <_InstallerRuntimePack Include="@(_InstallerCoreRuntimePack);@(_InstallerDesktopRuntimePack)" />
    </ItemGroup>
    <Error Condition="'@(_InstallerCoreRuntimePack)' == '' or '@(_InstallerDesktopRuntimePack)' == ''" Text="The installer's required runtime packages could not be resolved for license attribution." />
    <Error Condition="!Exists('%(_InstallerRuntimePack.PackageDirectory)/LICENSE') and !Exists('%(_InstallerRuntimePack.PackageDirectory)/LICENSE.TXT')"
           Text="The runtime pack %(_InstallerRuntimePack.Identity) has no license file." />
    <Error Condition="!Exists('%(_InstallerCoreRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" Text="The installer's .NET runtime third-party notices are missing." />
    <ItemGroup>
      <InstallerRuntimeNotice Include="%(_InstallerRuntimePack.PackageDirectory)/LICENSE*;%(_InstallerRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES*">
        <PackName>%(_InstallerRuntimePack.Identity)</PackName>
      </InstallerRuntimeNotice>
      <EmbeddedResource Include="@(InstallerRuntimeNotice)">
        <LogicalName>SpaceMaid.Installer.Notices.%(InstallerRuntimeNotice.PackName).%(InstallerRuntimeNotice.Filename)%(InstallerRuntimeNotice.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
