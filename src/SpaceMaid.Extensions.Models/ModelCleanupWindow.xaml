<Window x:Class="SpaceMaid.Extensions.Models.ModelCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review model cleanup" Width="640" SizeToContent="Height" MinWidth="480" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Delete this Ollama model?" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Model.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,6" />
                <TextBlock Text="{Binding Model.SizeText, StringFormat=Observed size: {0}}" />
                <TextBlock Text="Not loaded · Checked locally" Opacity="0.7" Margin="0,4,0,12" />
                <TextBlock Text="Permanently removes this model tag through local Ollama. This does not use the Recycle Bin. Shared data needed by other models may remain, so released space can be smaller than the model size." TextWrapping="Wrap" />
                <TextBlock Text="Preserve offline and local-only copies. Restoring may need a download or your original model files." TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="Avoid pulling, retagging or loading models until cleanup finishes. The app checks the name, digest and loaded state again before deletion, but concurrent changes can still happen between the check and deletion." TextWrapping="Wrap" Margin="0,10,0,12" />
                <TextBox Text="{Binding Model.Digest, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" AutomationProperties.Name="Confirmed model digest" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,10,0" />
            <Button x:Name="DeleteButton" Content="Delete model" Click="Delete_Click" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
