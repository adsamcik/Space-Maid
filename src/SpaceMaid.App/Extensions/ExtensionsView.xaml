<UserControl x:Class="SpaceMaid.App.Extensions.ExtensionsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="AddButton" Content="Add extension" Click="Add_Click" DockPanel.Dock="Right" Padding="14,6"/>
            <StackPanel><TextBlock Text="Extensions" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Manage trusted extensions. Open workflows from the sidebar." Opacity="0.7" Margin="0,4,16,0" TextWrapping="Wrap"/></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*" MinWidth="280"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" AutomationProperties.Name="Search extensions" Padding="10,7"/>
                    <TextBlock Text="Search extensions" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Opacity="0.6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid>
                <ListBox x:Name="ExtensionList" Grid.Row="1" SelectionChanged="Selection_Changed" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Installed extensions" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,9"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No matching extensions" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" Visibility="Collapsed"/>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="VersionText" Opacity="0.65" FontSize="12" Margin="0,5,0,16" TextWrapping="Wrap"/>
                        <CheckBox x:Name="EnabledBox" Content="Enable extension" Click="Enabled_Click"/>
                        <TextBlock x:Name="StateText" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="OpenButton" Content="Open workflow" Click="Open_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="14,6"/>
                        <TextBlock x:Name="IntegrationText" TextWrapping="Wrap" Opacity="0.75" Margin="0,16,0,0"/>
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <Expander Header="Extension details" Margin="0,20,0,0"><StackPanel Margin="0,8,0,0"><TextBox x:Name="IdText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AutomationProperties.Name="Extension ID"/><TextBox x:Name="LocationText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AutomationProperties.Name="Extension location"/></StackPanel></Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="Only add extensions you trust. They run with your account's permissions. Changes apply after restart." FontSize="12" Opacity="0.65" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
