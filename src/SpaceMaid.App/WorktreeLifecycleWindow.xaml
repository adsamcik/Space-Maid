<Window x:Class="SpaceMaid.App.WorktreeLifecycleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Managed worktrees" Width="1020" Height="730" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Managed worktrees" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Keep branches and recovery records. Retire only clean, integrated checkouts with no unknown local files." TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Checkouts">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="CheckoutList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="None" HeadersVisibility="Column">
                        <DataGrid.Columns><DataGridTextColumn Header="Checkout" Binding="{Binding Path}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="110"/><DataGridTextColumn Header="State" Binding="{Binding Status}" Width="200"/></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0" x:Name="PolicyControls">
                        <DockPanel><TextBlock Text="Integration target" Width="125" VerticalAlignment="Center"/><TextBox x:Name="TargetBox" Text="refs/heads/main" AutomationProperties.Name="Full integration branch reference" ToolTip="Use refs/heads/main or an explicit refs/remotes/origin/main. A feature's upstream is a separate retention fact."/></DockPanel>
                        <WrapPanel Margin="0,8,0,0"><TextBlock Text="Keep activity within" VerticalAlignment="Center"/><TextBox x:Name="DaysBox" Text="30" Width="48" Margin="8,0" AutomationProperties.Name="Days of observed worktree activity to retain"/><TextBlock Text="days" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBlock Text="Recovery grace" VerticalAlignment="Center"/><TextBox x:Name="GraceBox" Text="7" Width="48" Margin="8,0" AutomationProperties.Name="Days before permanent finalization"/><TextBlock Text="days" VerticalAlignment="Center"/></WrapPanel>
                        <CheckBox x:Name="ManagedBox" Content="This is a reproducible checkout I want Space Maid to manage" Margin="0,9,0,0"/>
                        <CheckBox x:Name="AutomaticBox" Content="Automatically quarantine, then permanently finalize after the grace period" Margin="0,7,0,0" ToolTip="Runs only while Space Maid is open and idle; each checkout is checked again."/>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="CheckButton" Content="Check selected" Click="Check_Click" Padding="12,5" Margin="0,0,8,0"/><Button x:Name="EnrollButton" Content="Save managed policy" Click="Enroll_Click" Padding="12,5" Margin="0,0,8,0"/><Button x:Name="QuarantineButton" Content="Quarantine selected" Click="Quarantine_Click" Padding="12,5"/></WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Recovery">
                <Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="RecoveryList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns><DataGridTextColumn Header="Original checkout" Binding="{Binding Original}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Quarantine}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="State" Binding="{Binding State}" Width="125"/><DataGridTextColumn Header="Earliest finalization" Binding="{Binding FinalizeAfter}" Width="155"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Quarantine keeps occupying space. Finalization permanently removes only recorded, unchanged files; the branch remains." TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="RestoreButton" Content="Restore selected" Click="Restore_Click" Padding="12,5" Margin="0,0,8,0"/><Button x:Name="FinalizeButton" Content="Permanently finalize selected" Click="Finalize_Click" Padding="12,5" Margin="0,0,8,0"/><Button x:Name="PauseButton" Content="Pause automatic retirement" Click="Pause_Click" Padding="12,5"/></WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="CloseButton" Content="Close" Click="Close_Click" DockPanel.Dock="Right" Padding="14,6" Margin="12,0,0,0"/><TextBlock x:Name="StatusText" Text="Select a checkout and check its integration and local contents." TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
    </Grid>
</Window>
