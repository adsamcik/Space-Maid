<Window x:Class="SpaceMaid.App.EmptyRecycleBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empty Recycle Bin" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Text="Empty Recycle Bin?" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="AccountScope" Margin="0,6,0,0" />
        <Grid Margin="0,16,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="BinScope" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <TextBlock x:Name="BinSize" Grid.Column="1" FontWeight="SemiBold" />
        </Grid>
        <StackPanel x:Name="LeftoverSummary" Visibility="Collapsed" Margin="0,0,0,12">
            <CheckBox x:Name="IncludeLeftovers" IsChecked="True" Checked="Selection_Changed" Unchecked="Selection_Changed">
                <TextBlock x:Name="LeftoverSize" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="Files with missing Recycle Bin records. Original names may be unavailable."
                       TextWrapping="Wrap" FontSize="13" Margin="26,4,0,0" />
        </StackPanel>
        <TextBlock x:Name="LeftoverNotice" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12" />
        <Grid x:Name="ScanSummary" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ScanSizeLabel" Text="On disk at last scan" />
            <TextBlock x:Name="ScanSize" Grid.Column="1" />
        </Grid>
        <TextBlock x:Name="Explanation" Text="Permanently deletes these items from your account on this drive. This cannot be undone. Other accounts are not affected." TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="KeepButton" Content="Cancel" IsCancel="True" IsDefault="True" Margin="0,0,8,0" />
            <Button x:Name="EmptyButton" Content="Empty Recycle Bin" Click="Empty_Click" />
        </StackPanel>
    </StackPanel>
</Window>
