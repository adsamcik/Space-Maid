<Window x:Class="SpaceMaid.App.EmptyRecycleBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empty Recycle Bin" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="20">
        <TextBlock Text="Empty Recycle Bin?" FontSize="20" FontWeight="SemiBold" />
        <Grid Margin="0,18,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="BinScope" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="BinSize" Grid.Column="1" FontSize="20" FontWeight="SemiBold" />
        </Grid>
        <TextBlock Text="Permanently deletes all recycled items on this drive. Cannot undo." TextWrapping="Wrap" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="KeepButton" Content="Cancel" IsCancel="True" IsDefault="True" Margin="0,0,8,0" />
            <Button x:Name="EmptyButton" Content="Empty Recycle Bin" Click="Empty_Click" />
        </StackPanel>
    </StackPanel>
</Window>
