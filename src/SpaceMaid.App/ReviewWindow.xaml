<Window x:Class="SpaceMaid.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup review" Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}"
        Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ReviewItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollContentPresenter}}}" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Grid Background="Transparent">
                    <Border x:Name="Highlight" Background="{DynamicResource WindowForeground}" Opacity="0" CornerRadius="5" />
                    <ContentPresenter />
                    <Border x:Name="Focus" BorderBrush="{DynamicResource WindowForeground}" BorderThickness="1" Opacity="0" CornerRadius="5" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.06" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.12" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Review cleanup" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="EstimateCaption" Opacity="0.7" Margin="0,4,0,0" /></StackPanel>
            <TextBlock x:Name="EstimateText" Grid.Column="1" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Selected estimate; shared files may remain in use." />
        </Grid>
        <Grid x:Name="SelectionControls" Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ReadyFilter" GroupName="ReviewState" Content="Ready" IsChecked="True" Tag="Ready" Style="{StaticResource ViewTab}" Checked="Filter_Checked" />
                <RadioButton x:Name="ManualFilter" GroupName="ReviewState" Content="Needs review" Tag="NeedsReview" Style="{StaticResource ViewTab}" Margin="16,0,0,0" Checked="Filter_Checked" />
                <RadioButton x:Name="KeptFilter" GroupName="ReviewState" Content="Kept" Tag="Protected" Style="{StaticResource ViewTab}" Margin="16,0,0,0" Checked="Filter_Checked" />
            </StackPanel>
            <Grid Grid.Column="1" MinWidth="130" MaxWidth="320" Margin="20,0,0,0">
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" AutomationProperties.Name="Search cleanup folders" ToolTip="Search folder paths or types" />
                <TextBlock Text="Search" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="GroupColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="GroupList" Margin="0,0,14,0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ReviewItem}" SelectionChanged="Group_Changed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Cleanup groups">
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid Margin="4,10,8,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsThreeState="True" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,3,0,0" ToolTip="{Binding SelectionHint}" AutomationProperties.Name="{Binding SelectionHint}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Count}" Opacity="0.65" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="12" Margin="8,0,0,0" />
                            </Grid>
                            <ProgressBar Value="{Binding RelativeSize, Mode=OneWay}" Maximum="100" Height="3" Margin="0,8,0,0" IsHitTestVisible="False" ToolTip="Observed sizes compared with the largest group" />
                        </StackPanel>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="4,0,8,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="106" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="VisibleSelection" IsThreeState="True" Click="VisibleSelection_Click" VerticalAlignment="Center" ToolTip="Select all matching folders, including other pages" AutomationProperties.Name="Select matching folders" />
                    <TextBlock x:Name="GroupCaption" Grid.Column="1" Text="Folders" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="Size" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Latest activity" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="LocationList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ReviewItem}" SelectionChanged="Location_Changed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Exact cleanup locations">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="4,8,8,8" MinHeight="40" ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="106" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" AutomationProperties.Name="{Binding SelectionHint}" />
                                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Activity}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" FontSize="12" ToolTip="{Binding ActivityTooltip}" />
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="No folders match." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Row="2" Margin="4,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" FontSize="12" Opacity="0.7" /><Button x:Name="PreviousPage" Grid.Column="1" Content="Previous" Click="Previous_Click" Margin="8,0,0,0" /><Button x:Name="NextPage" Grid.Column="2" Content="Next" Click="Next_Click" Margin="8,0,0,0" />
                </Grid>
                <Border x:Name="FolderDetails" Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="4,12,0,0" Padding="0,10,0,0" Visibility="Collapsed">
                        <Expander FontSize="12" MaxHeight="140" AutomationProperties.Name="Selected folder details" ToolTip="{Binding Path}">
                            <Expander.Header><TextBlock Text="{Binding DecisionReason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DecisionReason}" /></Expander.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,4,0">
                            <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="24" FontSize="12" AutomationProperties.Name="Exact selected path" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,6,0,0" /><TextBlock Text="{Binding Caution}" TextWrapping="Wrap" Margin="0,6,0,0" /><TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" />
                        </StackPanel></ScrollViewer></Expander>
                </Border>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <ProgressBar x:Name="CleanupProgressBar" Height="4" Visibility="Collapsed" Margin="0,0,0,8" /><TextBlock x:Name="ProgressPath" TextTrimming="CharacterEllipsis" FontSize="12" Visibility="Collapsed" Margin="0,0,0,6" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultText" Text="Empty the Recycle Bin to free space." TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                    <Expander Header="Review details" FontSize="12" Margin="0,5,0,0" MaxHeight="145"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,4,0">
                        <TextBlock Text="Includes each folder’s current contents. Stop active tools; synced deletions can affect cloud copies." TextWrapping="Wrap" />
                        <Expander x:Name="ValidationDetails" Header="Checks" Margin="0,6,0,0" Visibility="Collapsed"><TextBlock x:Name="ValidationText" TextWrapping="Wrap" Margin="0,6,0,0" /></Expander>
                        <TextBlock x:Name="CautionText" TextWrapping="Wrap" Margin="0,6,0,0" /><TextBlock x:Name="ResultDetailText" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel></ScrollViewer></Expander>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CloseButton" Content="Cancel" Click="Close_Click" IsDefault="True" Margin="0,0,10,0" /><Button x:Name="CleanupButton" Content="Move to Recycle Bin" IsEnabled="False" Click="Cleanup_Click" /></StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
