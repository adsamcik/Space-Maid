<Window x:Class="SpaceMaid.App.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fast scanning" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="20">
        <TextBlock Text="Enable fast scanning?" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Only the read-only scanner needs administrator access." TextWrapping="Wrap" Margin="0,10,0,20" Opacity="0.75" ToolTip="Space Maid and extensions stay unelevated. You can continue with standard scanning if you decline." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Continue without admin" IsDefault="True" IsCancel="True" Click="Continue_Click" Margin="0,0,10,0" />
            <Button Content="Enable fast scanning" Click="Enable_Click" Style="{DynamicResource AccentButtonStyle}" Padding="16,9" />
        </StackPanel>
    </StackPanel>
</Window>
