<Window x:Class="SpaceMaid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpaceMaid.App"
        Title="Space Maid" Icon="/SpaceMaid.App;component/Assets/SpaceMaid.ico" Width="1220" Height="940" MinWidth="1020" MinHeight="820"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PathKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="ScanHeader" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="PathBar" VerticalAlignment="Center" Margin="0,0,12,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5" MinHeight="38" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" PreviewMouseLeftButtonDown="PathBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" CornerRadius="4,0,0,4" IsHitTestVisible="False" />
                        <Button x:Name="DriveRootButton" Click="DriveRoot_Click" Style="{StaticResource PathCrumb}" Padding="10,5,6,5" MinHeight="36">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="DriveRootText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DrivesButton" Grid.Column="1" Click="Drives_Click" Style="{StaticResource PathCrumb}" Padding="8,5" MinWidth="36" MinHeight="36" ToolTip="Change drive (Alt+Down)" AutomationProperties.Name="Change drive" AutomationProperties.HelpText="Choose a drive or a saved cleanup shortcut.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DriveSwitchLabel" Text="Change drive" Visibility="Collapsed" Margin="2,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer x:Name="PathScroll" Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="4,0,0,0">
                            <StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" VerticalAlignment="Center" />
                        </ScrollViewer>
                        <TextBox x:Name="PathEditor" Grid.Column="2" Grid.ColumnSpan="2" Visibility="Collapsed" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" KeyDown="PathEditor_KeyDown" LostKeyboardFocus="PathEditor_LostFocus" AutomationProperties.Name="Folder path" AutomationProperties.HelpText="Enter to open or scan a folder. Escape to cancel." />
                        <Button x:Name="EditPathButton" Grid.Column="3" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Click="EditPath_Click" Style="{StaticResource PathCrumb}" ToolTip="Edit path (Ctrl+L)" AutomationProperties.Name="Edit folder path" />
                        <Popup x:Name="DrivePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=PathBar}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border x:Name="DrivePickerPanel" Style="{StaticResource Card}" Background="{DynamicResource WindowBackground}" Width="440" Padding="8" Margin="0,5,0,0" PreviewKeyDown="DrivePopup_KeyDown">
                                <StackPanel>
                                    <TextBlock Text="Change drive" FontWeight="SemiBold" FontSize="14" Margin="10,5,10,8" />
                                    <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="DriveChoices" KeyboardNavigation.TabNavigation="Continue">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Margin="0,0,0,4" CornerRadius="4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <StackPanel>
                                                        <Button Click="ChooseDrive_Click" IsEnabled="{Binding Ready}" Style="{StaticResource PathCrumb}" HorizontalContentAlignment="Stretch" Padding="12,10" ToolTip="{Binding HistoryTooltip}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Capacity}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,2,0,0" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Capacity}" Opacity="0.75" Margin="0,4,0,0" FontSize="12" />
                                                                    <ProgressBar Value="{Binding FreePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" MinHeight="0" Margin="0,7,0,0" AutomationProperties.Name="Free space as a share of drive capacity">
                                                                        <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasCapacity}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                                                                    </ProgressBar>
                                                                    <TextBlock Text="{Binding HistoryCaption}" Opacity="0.6" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasScanHistory}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                                    <TextBlock Text="Selected" FontSize="11">
                                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding SpaceHint}" Opacity="0.75" FontSize="11" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <ItemsControl ItemsSource="{Binding Recommendations}" Margin="34,0,8,4">
                                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                                <Button Click="Recommendation_Click" IsEnabled="{Binding Ready}" Style="{StaticResource PathCrumb}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}">
                                                                    <DockPanel><TextBlock Text="›" DockPanel.Dock="Right" FontSize="18" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.6" /><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></DockPanel>
                                                                </Button>
                                                            </DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Tag="recent" ToolTip="{Binding RecentPath}" IsEnabled="{Binding Ready}" Click="ChooseDrive_Click" Margin="34,0,8,6" HorizontalAlignment="Left" AutomationProperties.Name="{Binding RecentPath}">
                                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PathCrumb}"><Setter Property="Visibility" Value="Collapsed" /><Setter Property="MaxWidth" Value="370" /><Style.Triggers><DataTrigger Binding="{Binding HasRecentFolder}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                            <TextBlock Text="{Binding RecentFolder}" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="DrivePickerNote" FontSize="12" Opacity="0.65" Margin="8,2,8,0" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ElevateButton" Content="Enable fast scanning" Click="Elevate_Click" Margin="0,0,8,0" Padding="12,5" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Visibility="Collapsed" Padding="12,5" />
                    <Button x:Name="ScanButton" Content="Scan" Click="Scan_Click" Style="{DynamicResource AccentButtonStyle}" Padding="18,5" />
                </StackPanel>
                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,9,0,0">
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,16,0">
                            <WrapPanel><TextBlock Text="Free" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="FreeSpaceText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="CapacityText" Text="Choose a drive" Opacity="0.65" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" /></WrapPanel>
                            <ProgressBar x:Name="DriveCapacityBar" Minimum="0" Maximum="100" Height="4" MinHeight="0" Margin="0,6,0,0" AutomationProperties.Name="Free space as a share of drive capacity" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <WrapPanel><TextBlock x:Name="ScannedSizeLabel" Text="Scanned" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="ScannedSizeText" Text="—" FontSize="20" FontWeight="SemiBold" /></WrapPanel>
                            <TextBlock x:Name="ScannedSizeCaption" Text="On disk" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value="On disk"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <WrapPanel><TextBlock Text="Detected storage" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="CandidateText" Text="—" FontSize="20" FontWeight="SemiBold" /></WrapPanel>
                            <TextBlock x:Name="CandidateCaption" Text="Estimate" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="Observed estimate, including kept storage. Overlapping folders are counted once. Review checks what can be cleaned up.">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value="Estimate"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <Button x:Name="MoreButton" Content="&#xE712;" FontFamily="Segoe Fluent Icons" Click="More_Click" DockPanel.Dock="Right" Padding="8,4" MinWidth="32" MinHeight="28" Margin="8,0,0,0" ToolTip="More" AutomationProperties.Name="More options">
                <Button.ContextMenu><ContextMenu FontFamily="Segoe UI">
                    <MenuItem Header="Find duplicates and preserve storage…" Click="Duplicates_Click" />
                    <MenuItem Header="Worktrees…" Click="WorktreeLifecycle_Click" />
                    <MenuItem Header="Tool caches…" Click="ToolCaches_Click" />
                    <Separator/><MenuItem Header="Updates…" Click="Updates_Click" />
                </ContextMenu></Button.ContextMenu>
            </Button>
            <Button x:Name="UpdateButton" Content="Update available" Click="Updates_Click" DockPanel.Dock="Right" Padding="10,4" MinHeight="28" Margin="8,0,0,0" Visibility="Collapsed" />
            <Button Content="Extensions" Click="Extensions_Click" DockPanel.Dock="Right" Padding="10,4" MinHeight="28" VerticalAlignment="Center" />
            <Button Content="Auto optimize" Click="Optimization_Click" DockPanel.Dock="Right" Padding="10,4" MinHeight="28" Margin="0,0,8,0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ExploreTab" Content="Explore space" Style="{StaticResource ViewTab}" GroupName="View" IsChecked="True" Checked="View_Changed" Margin="0,0,22,0" />
              <RadioButton x:Name="OpportunitiesTab" Content="Opportunities" Style="{StaticResource ViewTab}" GroupName="View" Checked="View_Changed" Margin="0,0,22,0" />
              <RadioButton x:Name="PhotosTab" Content="Photos" Style="{StaticResource ViewTab}" GroupName="View" Checked="View_Changed" Margin="0,0,22,0" />
              <RadioButton x:Name="AppsTab" Content="Apps" Style="{StaticResource ViewTab}" GroupName="View" Checked="View_Changed" />
            </StackPanel>
          </DockPanel>
          <Grid x:Name="PhotosPanel" Grid.Row="1" Visibility="Collapsed">
              <ContentControl x:Name="PhotosContent" />
              <Border x:Name="PhotosPlaceholder" Style="{StaticResource Card}"><TextBlock x:Name="ExtensionsStatusText" Text="Loading Photos…" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" /></Border>
          </Grid>
          <Grid x:Name="AppsPanel" Grid.Row="1" Visibility="Collapsed">
              <ContentControl x:Name="AppsContent" />
              <Border x:Name="AppsPlaceholder" Style="{StaticResource Card}"><TextBlock x:Name="AppsStatusText" Text="Loading Apps…" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" /></Border>
          </Grid>
          <Grid x:Name="ExplorePanel" Grid.Row="1" PreviewKeyDown="Explore_KeyDown">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="0">
                  <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <ListView x:Name="SpaceTree" Grid.RowSpan="2" Margin="5,4,5,0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" SizeChanged="Tree_SizeChanged"
                               SelectionChanged="Tree_Changed" PreviewKeyDown="Tree_KeyDown" PreviewMouseDown="Tree_MouseDown" MouseDoubleClick="Tree_DoubleClick" ContextMenuOpening="Tree_ContextMenuOpening"
                               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Folder and file tree. Use Left and Right to collapse and expand folders. Delete recycles the selected folder after confirmation. Right-click a folder for its operations.">
                          <ListView.ContextMenu><ContextMenu /></ListView.ContextMenu>
                          <ListView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                          <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource TreeRow}" /></ListView.ItemContainerStyle>
                          <ListView.View>
                              <GridView x:Name="TreeColumns" ColumnHeaderContainerStyle="{StaticResource TreeColumnHeader}" AllowsColumnReorder="True">
                                  <GridViewColumn x:Name="NameColumn" Width="260">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="NameHeader" Content="Name" Tag="Name" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" HorizontalContentAlignment="Left" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><Grid Margin="{Binding Indent}" MinHeight="34" ClipToBounds="True">
                                          <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="21" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                          <Button Content="{Binding Expander}" IsEnabled="{Binding CanExpand}" Click="Expand_Click" Style="{StaticResource FolderExpander}" AutomationProperties.Name="{Binding Name, StringFormat='Expand or collapse {0}'}" />
                                          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Opacity="0.65" Grid.Column="1" VerticalAlignment="Center" />
                                          <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Flags}" FontSize="11" Opacity="0.65"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Flags}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                      </Grid></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                                  <GridViewColumn x:Name="AllocationColumn" Width="96">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="AllocationHeader" Content="Allocated ↓" Tag="Allocated" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Allocated}" Style="{StaticResource TreeNumberCell}" ToolTip="{Binding SizeNote}" /></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                                  <GridViewColumn x:Name="ModifiedColumn" Width="150">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="ModifiedHeader" Content="Modified" Tag="Modified" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" HorizontalContentAlignment="Left" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Modified}" Style="{StaticResource TreeTextCell}" ToolTip="{Binding DateNote}" /></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                                  <GridViewColumn x:Name="LogicalColumn" Width="96">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="LogicalHeader" Content="Logical" Tag="Logical" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Logical}" Style="{StaticResource TreeNumberCell}" /></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                                  <GridViewColumn x:Name="ShareColumn" Width="80">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="ShareHeader" Content="% parent" Tag="Share" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Share}" Style="{StaticResource TreeNumberCell}" Opacity="0.65" /></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                                  <GridViewColumn x:Name="CreatedColumn" Width="150">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="CreatedHeader" Content="Created" Tag="Created" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" HorizontalContentAlignment="Left" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Created}" Style="{StaticResource TreeTextCell}" ToolTip="{Binding DateNote}" /></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                                  <GridViewColumn x:Name="TypeColumn" Width="170">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="TypeHeader" Content="Type" Tag="Type" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" HorizontalContentAlignment="Left" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Type}" Style="{StaticResource TreeTextCell}" ToolTip="{Binding TypeDescription}" /></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                                  <GridViewColumn x:Name="ExtensionColumn" Width="90">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="ExtensionHeader" Content="Extension" Tag="Extension" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" HorizontalContentAlignment="Left" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Extension}" Style="{StaticResource TreeTextCell}" /></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                                  <GridViewColumn x:Name="AttributesColumn" Width="180">
                                      <GridViewColumn.Header><GridViewColumnHeader x:Name="AttributesHeader" Content="Attributes" Tag="Attributes" Click="TreeSort_Click" Style="{StaticResource TreeColumnHeader}" HorizontalContentAlignment="Left" /></GridViewColumn.Header>
                                      <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Attributes}" Style="{StaticResource TreeTextCell}" ToolTip="{Binding Attributes}" /></DataTemplate></GridViewColumn.CellTemplate>
                                  </GridViewColumn>
                              </GridView>
                          </ListView.View>
                      </ListView>
                      <TextBlock x:Name="TreeHint" Text="Scan a drive to explore." HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Margin="24" TextWrapping="Wrap" Opacity="0.65" />
                      <DockPanel Grid.Row="2" Margin="12,4,8,4">
                          <Button x:Name="ColumnsButton" DockPanel.Dock="Right" Content="Columns" Click="Columns_Click" Style="{StaticResource ColumnHeader}" ToolTip="Choose columns. Drag headers to reorder; drag their edges to resize." AutomationProperties.Name="Choose tree columns" />
                          <TextBlock x:Name="TreeNote" Text="Shared files counted once" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.65" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value="Shared files counted once"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                          </TextBlock>
                      </DockPanel>
                  </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                  <Grid x:Name="MapLayout">
                      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <local:TreemapPanel x:Name="SpaceMap" MinHeight="120" ClipToBounds="True" AutomationProperties.Name="Framed folder treemap with one nested child level. Choose a contributor to see its files." />
                      <TextBlock x:Name="MapHint" Text="Select a folder." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.65" Margin="22" />
                      <WrapPanel Grid.Row="1" Margin="0,8,0,0" Opacity="0.75">
                          <StackPanel Orientation="Horizontal" Margin="0,0,12,5"><Border x:Name="ProjectSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" /><TextBlock Text="Projects &amp; data" FontSize="11" /></StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,12,5"><Border x:Name="CacheSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" /><TextBlock Text="Build &amp; cache" FontSize="11" /></StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,12,5"><Border x:Name="AgentSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" /><TextBlock Text="Agent files" FontSize="11" /></StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Border x:Name="OtherSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" /><TextBlock Text="Other" FontSize="11" /></StackPanel>
                          <TextBlock x:Name="MapBasis" Text="Area = allocated size" FontSize="11" Margin="12,0,0,5" />
                      </WrapPanel>
                      <StackPanel Grid.Row="2" x:Name="EntryDetail" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
                          <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,7" />
                          <TextBox x:Name="SelectedEntryPath" Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" FontSize="12" Padding="0" ToolTip="{Binding Path}" AutomationProperties.Name="Selected entry path" />
                          <TextBlock x:Name="EntryTypeText" Text="{Binding TypeDescription}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding TypeDescription}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                          <WrapPanel Margin="0,4,0,0"><TextBlock Text="Allocated" Opacity="0.65" FontSize="12" Margin="0,0,5,0" /><TextBlock Text="{Binding Allocated}" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" /><TextBlock Text="Logical" Opacity="0.65" FontSize="12" Margin="0,0,5,0" /><TextBlock Text="{Binding Logical}" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" /><TextBlock Text="Of parent" Opacity="0.65" FontSize="12" Margin="0,0,5,0" /><TextBlock Text="{Binding Share}" FontWeight="SemiBold" FontSize="12" /></WrapPanel>
                          <TextBlock Text="{Binding SizeNote}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" ToolTip="{Binding SizeNote}" Opacity="0.65" FontSize="11" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SizeNote}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      </StackPanel>
                  </Grid>
              </Border>
          </Grid>
          <Border x:Name="PreliminaryPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
              <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Margin="18,16">
                      <TextBlock Text="Largest files · Preliminary" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock x:Name="PreliminaryCaption" Text="Scanning…" TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="0,6,0,0" />
                  </StackPanel>
                  <Grid Grid.Row="1" Margin="22,0,24,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                      <Button x:Name="PreliminaryNameHeader" Content="File" Tag="Name" Click="PreliminarySort_Click" Style="{StaticResource ColumnHeader}" HorizontalContentAlignment="Left" />
                      <Button x:Name="PreliminaryAllocationHeader" Content="Allocated ↓" Tag="Allocated" Click="PreliminarySort_Click" Grid.Column="1" Style="{StaticResource ColumnHeader}" />
                      <Button x:Name="PreliminaryLogicalHeader" Content="Logical" Tag="Logical" Click="PreliminarySort_Click" Grid.Column="2" Style="{StaticResource ColumnHeader}" />
                  </Grid>
                  <ListBox x:Name="PreliminaryFiles" Grid.Row="2" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                           AutomationProperties.Name="Preliminary largest files found so far">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="5,0" /><Setter Property="AutomationProperties.Name" Value="{Binding PathText}" /></Style></ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                          <DataTemplate>
                              <Grid MinHeight="54" Margin="6,0" ToolTip="{Binding EntryTooltip}">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                      <TextBlock Text="{Binding File.Name}" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.65" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <TextBlock Text="{Binding Allocated}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                  <TextBlock Text="{Binding Logical}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                              </Grid>
                          </DataTemplate>
                      </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="PreliminaryHint" Grid.Row="2" Text="Waiting for file metadata…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" Margin="24" TextWrapping="Wrap" />
                  <TextBlock x:Name="PreliminaryNote" Grid.Row="3" Text="Largest 100 files · Shared files counted once" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="18,14" />
              </Grid>
          </Border>
          <Grid x:Name="OpportunitiesPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="5" Margin="0,0,0,14" x:Name="OpportunityToolbar">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="WorktreeOptionsToggle" Content="Worktrees" Click="OpportunityOptions_Click" Visibility="Collapsed" Padding="12,6" Margin="0,0,8,0" AutomationProperties.Name="Show worktree cleanup options" />
                        <ToggleButton x:Name="ViewOptionsToggle" Content="View options" Click="OpportunityOptions_Click" Padding="12,6" AutomationProperties.Name="Show grouping and sorting options" />
                    </StackPanel>
                    <Button x:Name="BackToCleanupButton" Content="← Cleanup groups" Click="BackToCleanup_Click" Visibility="Collapsed" HorizontalAlignment="Left" />
                    <TextBlock x:Name="OpportunityPanelTitle" Text="Cleanup groups" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border x:Name="ViewOptionsPanel" Grid.Row="1" Margin="0,12,0,0">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource OptionsPanel}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ViewOptionsToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,18,0"><TextBlock Text="Group by" FontSize="12" Opacity="0.65" Margin="0,0,0,6" />
                            <ComboBox x:Name="OpportunityGroupingPicker" Width="185" SelectedIndex="0" SelectionChanged="OpportunityFilter_Changed" AutomationProperties.Name="Opportunity view"><ComboBoxItem Content="Cleanup groups" /><ComboBoxItem Content="Project / folder" /><ComboBoxItem Content="Clutter type" /></ComboBox>
                        </StackPanel>
                        <StackPanel><TextBlock Text="Sort" FontSize="12" Opacity="0.65" Margin="0,0,0,6" />
                            <ComboBox x:Name="OpportunitySortPicker" Width="150" SelectedIndex="0" SelectionChanged="OpportunityFilter_Changed" AutomationProperties.Name="Sort opportunity groups and locations"><ComboBoxItem Content="Largest first" /><ComboBoxItem Content="Name A–Z" /><ComboBoxItem Content="Most locations" /></ComboBox>
                        </StackPanel>
                        <StackPanel Margin="18,0,0,0"><TextBlock Text="Keep recent builds" FontSize="12" Opacity="0.65" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" ToolTip="Keeps outputs with recent file changes or creation, including direct project files. Actual last use is not tracked. Unknown activity is kept. Stop builds before cleanup.">
                                <TextBox x:Name="BuildKeepRecentDaysBox" Text="3" Width="64" MaxLength="3" KeyDown="BuildRetention_KeyDown" LostFocus="BuildRetention_LostFocus" AutomationProperties.Name="Keep builds active within this many days" />
                                <TextBlock Text="days" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="WorktreeCleanupControls" Grid.Row="1" Margin="0,12,0,0">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource OptionsPanel}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=WorktreeOptionsToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="WorktreeRulePicker" SelectedIndex="0" SelectionChanged="WorktreeRule_Changed" Width="250" HorizontalAlignment="Left" AutomationProperties.Name="Worktree cleanup rule"><ComboBoxItem Content="Old and integrated" /><ComboBoxItem Content="Old worktrees" /><ComboBoxItem Content="Integrated · any age" /></ComboBox>
                        <Button x:Name="CheckWorktreesButton" Grid.Column="1" Content="Check worktrees" Click="CheckWorktrees_Click" ToolTip="Check local Git status, integration and observed activity. May read local files; does not fetch remote data." IsEnabled="False" />
                        <Grid Grid.Row="1" Margin="0,16,24,14" MaxWidth="640" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="340" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <Label x:Name="WorktreeAgeLabel" Content="_Inactive for" Target="{Binding ElementName=WorktreeAgeSlider}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Slider x:Name="WorktreeAgeSlider" Grid.Column="1" Minimum="1" Maximum="365" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="7" ValueChanged="WorktreeAge_Changed" VerticalAlignment="Center" AutomationProperties.Name="Worktree inactivity threshold in days" ToolTip="Latest observed file change or Git reflog activity; actual file access is not tracked." />
                            <TextBlock x:Name="WorktreeAgeText" Grid.Column="2" Text="30 days" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="WorktreeRuleHint" Grid.Row="1" Grid.Column="1" Text="Local changes protected · Branches kept" FontSize="11" Opacity="0.7" TextWrapping="Wrap" MaxWidth="230" VerticalAlignment="Center" />
                        <TextBlock x:Name="WorktreeCheckSummary" Grid.Row="2" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,24,0" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="SelectWorktreeMatchesButton" Grid.Row="2" Grid.Column="1" Content="Select matches" Click="SelectWorktreeMatches_Click" IsEnabled="False" Padding="12,6" />
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="CleanupOverview" Grid.Row="1" Grid.ColumnSpan="5" Style="{StaticResource Card}" Padding="20,4,20,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="RecycleBinRow" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="15" Width="30" Height="30" Padding="0" Click="RefreshRecycleBin_Click" ToolTip="Refresh Recycle Bin" AutomationProperties.Name="Refresh Recycle Bin" />
                            <TextBlock Grid.Column="1" Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="22" VerticalAlignment="Center" Margin="5,0,0,0" />
                            <TextBlock x:Name="RecycleBinTitle" Grid.Column="2" Text="Recycle Bin" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                                <TextBlock x:Name="RecycleBinSize" Text="—" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" ToolTip="Windows' bin size; actual released space may differ." />
                                <TextBlock x:Name="RecycleBinCount" Text="Checking…" FontSize="11" Opacity="0.65" HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="EmptyRecycleBinButton" Grid.Column="4" Content="Empty…" Click="EmptyRecycleBin_Click" IsEnabled="False" VerticalAlignment="Center" Padding="9,5" AutomationProperties.Name="Empty Recycle Bin on selected drive" />
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="CleanupOverviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CleanupGroupCards" AutomationProperties.Name="Cleanup checklist">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,16" ToolTip="{Binding Description}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <CheckBox IsThreeState="True" IsChecked="{Binding Checked, Mode=OneWay}" IsEnabled="{Binding CanSelectGroup}" ToolTip="{Binding SelectionHint}" ToolTipService.ShowOnDisabled="True" Click="CleanupGroupSelection_Click" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Select {0} for cleanup}" />
                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{Binding DecisionHint}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.7" Margin="0,4,0,0" ToolTip="{Binding Summary}" />
                                            <ProgressBar Value="{Binding RelativeSize, Mode=OneWay}" Height="5" MinHeight="0" Maximum="100" Margin="0,10,0,0" ToolTip="{Binding SizeComparison}" AutomationProperties.Name="{Binding SizeComparison}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                                            <TextBlock Text="{Binding Size}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Count}" FontSize="11" Opacity="0.65" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="125" ToolTip="{Binding Count}" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="View folders" Click="ViewCleanupGroup_Click" VerticalAlignment="Center" Padding="9,5" AutomationProperties.Name="{Binding Name, StringFormat=View folders in {0}}" />
                                        <Expander x:Name="CleanupBreakdownExpander" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Header="{Binding BreakdownHeading}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Expanded="CleanupExpander_Changed" Collapsed="CleanupExpander_Changed" Foreground="{DynamicResource WindowForeground}" FontSize="12" Margin="0,10,0,0">
                                            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasChildren}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Expander.Style>
                                            <ItemsControl ItemsSource="{Binding Children}" Foreground="{DynamicResource WindowForeground}" Margin="0,6,0,0" AutomationProperties.Name="{Binding BreakdownHeading}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                            <CheckBox IsThreeState="True" IsChecked="{Binding Checked, Mode=OneWay}" Click="CleanupGroupSelection_Click" VerticalAlignment="Center" ToolTip="{Binding SelectionHint}" AutomationProperties.Name="{Binding Name, StringFormat=Select {0} for cleanup}" />
                                                            <StackPanel Grid.Column="1" Margin="4,0,12,0" ToolTip="{Binding Description}">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontSize="11" Opacity="0.65" Margin="0,3,0,0"><Run Text="{Binding ProjectCount, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Count, Mode=OneWay}" /></TextBlock>
                                                                <TextBlock Text="{Binding Group.Caption}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasContentGroups}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                </TextBlock>
                                                                <ProgressBar Value="{Binding RelativeSize, Mode=OneWay}" Height="4" MinHeight="0" Maximum="100" Margin="0,7,8,0" ToolTip="{Binding SizeComparison}" AutomationProperties.Name="{Binding SizeComparison}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Size}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                                                            <Button Grid.Column="3" Content="View projects" Click="ViewCleanupProjects_Click" VerticalAlignment="Center" Padding="9,5" AutomationProperties.Name="{Binding Name, StringFormat=View projects for {0}}" />
                                                            <Expander x:Name="CleanupContentExpander" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Header="What would be cleaned" Foreground="{DynamicResource WindowForeground}" IsExpanded="{Binding ContentsExpanded, Mode=TwoWay}" Expanded="CleanupExpander_Changed" Collapsed="CleanupExpander_Changed" Margin="4,6,0,0" AutomationProperties.Name="{Binding Name, StringFormat=What would be cleaned for {0}}">
                                                                <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasContentGroups}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Expander.Style>
                                                                <StackPanel Margin="0,6,0,0">
                                                                    <TextBlock Text="Whole folders, including any custom files. Sizes may overlap." FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                                                    <ItemsControl ItemsSource="{Binding ContentGroups}" Foreground="{DynamicResource WindowForeground}" AutomationProperties.Name="Detected build folder types">
                                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                                            <Grid Margin="0,10,0,4">
                                                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                                <TextBlock Grid.Column="1" FontSize="12"><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Size, Mode=OneWay}" /></TextBlock>
                                                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,4,0,0"><Run Text="Usually contains: " /><Run Text="{Binding Group.Caption, Mode=OneWay}" /></TextBlock>
                                                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Group.StatusLabel}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Group.Summary}" TextWrapping="Wrap" FontSize="11" Opacity="0.75" Margin="0,4,0,0" />
                                                                            </Grid>
                                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Expander>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="CleanupOverviewNote" Grid.Row="2" FontSize="11" Opacity="0.65" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" Text="Scan a drive to find cleanup groups." />
                </Grid>
            </Border>
            <Border x:Name="OpportunityNavigation" Grid.Row="1" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <Grid x:Name="GroupBrowserControls">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="12">
                        <TextBlock x:Name="CleanupScopeText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Button x:Name="AllOpportunitiesButton" Content="All locations" Click="AllOpportunities_Click" HorizontalContentAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock x:Name="GroupNavigationSummary" FontSize="11" Opacity="0.65" Margin="0,8,0,0" />
                    </StackPanel>
                    <ListBox x:Name="OpportunityGroupList" Grid.Row="1" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" SelectionChanged="OpportunityGroup_Changed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Opportunity groups">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6,2" /><Setter Property="AutomationProperties.Name" Value="{Binding Description}" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel MinHeight="65" Margin="2,4" ToolTip="{Binding Description}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Size}" FontWeight="SemiBold" FontSize="12" Margin="0,3,0,0" />
                                <ProgressBar Value="{Binding RelativeSize, Mode=OneWay}" Height="4" MinHeight="0" Maximum="100" Margin="0,6,0,0" ToolTip="{Binding SizeComparison}" AutomationProperties.Name="{Binding SizeComparison}" />
                                <TextBlock Text="{Binding Count}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="GroupSizeNote" Grid.Row="2" Margin="12" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Border x:Name="OpportunityLocations" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="14,12">
                        <TextBlock x:Name="OpportunityHeading" Text="All locations" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="OpportunityScopeText" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12" Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock x:Name="OpportunityResultSummary" FontSize="11" Opacity="0.7" Margin="0,5,0,0" />
                    </StackPanel>
                    <Grid x:Name="OpportunityFilters" Grid.Row="1" Margin="12,0,12,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Search" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBox x:Name="OpportunitySearch" Grid.Column="1" MinWidth="0" TextChanged="OpportunitySearch_Changed" AutomationProperties.Name="Search opportunity names, paths, types and projects" />
                        <ComboBox x:Name="OpportunityTypeFilter" Grid.Column="3" SelectionChanged="OpportunityFilter_Changed" AutomationProperties.Name="Filter opportunity type" />
                    </Grid>
                    <ListBox x:Name="OpportunityGrid" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single" SelectionChanged="Opportunity_Changed" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Space opportunities">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="3,0" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="58" Margin="4,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" ToolTip="{Binding Item.CleanupBlockReason}" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=Select {0} for preview}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" FontSize="13" />
                                        <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" FontSize="12" Opacity="0.65" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding ScopeLabel}" FontSize="11" Opacity="0.65" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ScopeLabel}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <TextBlock x:Name="EmptyTitle" Text="Find cleanup opportunities" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyCaption" Text="Scan a drive to start." Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.65">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="OpportunityDetails" Grid.Row="1" Grid.Column="4" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailHint" Text="Select a folder for details." TextWrapping="Wrap" Opacity="0.65" />
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Category}" Opacity="0.65" FontSize="12" Margin="0,6,0,12" />
                            <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" />
                            <TextBlock Text="{Binding Caution}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <StackPanel x:Name="BuildFolderContentsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock Text="Inside this folder" FontWeight="SemiBold" />
                                <ItemsControl x:Name="BuildFolderContentsList" Margin="0,6,0,0" AutomationProperties.Name="Scanned build folder contents">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,3" ToolTip="{Binding Detail}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" />
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="BuildFolderContentsNote" TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                            <Expander Header="Details" Margin="0,14,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock x:Name="WorktreeDetailText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>
                            <Button Content="Open folder" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,22,0,0" />
                            <Button Content="Show in tree" Click="ShowInTree_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,10,0,0">
                <TextBlock x:Name="CleanupFreshnessText" FontSize="12" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Visibility="Collapsed" />
                <DockPanel>
                    <Button x:Name="ReviewButton" Content="Review cleanup" Click="Review_Click" DockPanel.Dock="Right" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" ToolTip="Recheck selected locations, then confirm moving eligible folders to the Recycle Bin." />
                    <Button x:Name="ClearOpportunitySelectionButton" Content="Clear selection" Click="ClearOpportunitySelection_Click" DockPanel.Dock="Right" Margin="0,0,8,0" />
                    <Button x:Name="SelectListedButton" Content="Select listed" Click="SelectListedOpportunities_Click" DockPanel.Dock="Left" Margin="0,0,12,0" Visibility="Collapsed" ToolTip="Select all locations in the current group and filters to review cleanup." />
                    <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                </DockPanel>
            </StackPanel>
          </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Grid Height="4"><ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" /></Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="20" ClipToBounds="True" FontSize="12" Opacity="0.7" Margin="0,0,18,0" ToolTip="Open Details for the full message." AutomationProperties.LiveSetting="Polite" AutomationProperties.HelpText="Open Details for the full message." />
                <TextBlock x:Name="BackendStatusText" Grid.Column="1" Visibility="Collapsed" TextTrimming="CharacterEllipsis" MaxWidth="260" MaxHeight="20" ClipToBounds="True" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="0,0,14,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
                <ToggleButton x:Name="DiagnosticsToggle" Grid.Column="2" Content="Details" Padding="10,4" MinHeight="28" AutomationProperties.Name="Show full status and diagnostics" />
            </Grid>
            <TextBlock x:Name="ExtensionJobText" Visibility="Collapsed" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="20" ClipToBounds="True" Margin="0,6,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
            <Border x:Name="DiagnosticsPanel" Margin="0,12,0,0">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource OptionsPanel}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=DiagnosticsToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <TextBox x:Name="DiagnosticMessage" Text="{Binding Text, ElementName=StatusText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="160" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="Full operation status" />
                    <TextBlock Text="{Binding Text, ElementName=BackendStatusText}" TextWrapping="Wrap" MaxHeight="44" ClipToBounds="True" FontSize="12" Opacity="0.7" Margin="0,10,0,0" ToolTip="{Binding Text, ElementName=BackendStatusText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="OpenLogButton" Content="Open log" Click="OpenLog_Click" Visibility="Collapsed" Padding="12,5" Margin="0,0,10,0" />
                        <Button x:Name="DetailsButton" Content="Scan details" Click="Details_Click" Visibility="Collapsed" Padding="12,5" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
