<Window x:Class="SpaceMaid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpaceMaid.App"
        Title="Space Maid" Width="1220" Height="940" MinWidth="1020" MinHeight="820"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="ScanHeader" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="460" HorizontalAlignment="Left">
                    <Label Content="_Drive" Target="{Binding ElementName=DrivePicker}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="DrivePicker" MinWidth="260" SelectionChanged="Drive_Changed" AutomationProperties.Name="Drive to scan" />
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ElevateButton" Content="Enable fast scanning" Click="Elevate_Click" Margin="0,0,8,0" Padding="12,5" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Visibility="Collapsed" Padding="12,5" />
                    <Button x:Name="ScanButton" Content="Scan drive" Click="Scan_Click" Style="{DynamicResource AccentButtonStyle}" Padding="18,5" />
                </StackPanel>
                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,9,0,0">
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,16,0">
                            <WrapPanel><TextBlock Text="Free" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="FreeSpaceText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="CapacityText" Text="Choose a drive" Opacity="0.65" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" /></WrapPanel>
                            <ProgressBar x:Name="DriveCapacityBar" Minimum="0" Maximum="100" Height="4" MinHeight="0" Margin="0,6,0,0" AutomationProperties.Name="Free space as a share of drive capacity" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <WrapPanel><TextBlock x:Name="ScannedSizeLabel" Text="Scanned" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="ScannedSizeText" Text="—" FontSize="20" FontWeight="SemiBold" /></WrapPanel>
                            <TextBlock x:Name="ScannedSizeCaption" Text="Allocated · Shared files counted once" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <StackPanel>
                            <WrapPanel><TextBlock Text="Candidates" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="CandidateText" Text="—" FontSize="20" FontWeight="SemiBold" /></WrapPanel>
                            <TextBlock x:Name="CandidateCaption" Text="Estimate · Subject to review" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <Button Content="Extensions" Click="Extensions_Click" DockPanel.Dock="Right" Padding="10,4" MinHeight="28" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ExploreTab" Content="Explore space" Style="{StaticResource ViewTab}" GroupName="View" IsChecked="True" Checked="View_Changed" Margin="0,0,22,0" />
              <RadioButton x:Name="OpportunitiesTab" Content="Opportunities" Style="{StaticResource ViewTab}" GroupName="View" Checked="View_Changed" Margin="0,0,22,0" />
              <RadioButton x:Name="PhotosTab" Content="Photos" Style="{StaticResource ViewTab}" GroupName="View" Checked="View_Changed" />
            </StackPanel>
          </DockPanel>
          <Grid x:Name="PhotosPanel" Grid.Row="1" Visibility="Collapsed">
              <ContentControl x:Name="PhotosContent" />
              <Border x:Name="PhotosPlaceholder" Style="{StaticResource Card}"><TextBlock x:Name="ExtensionsStatusText" Text="Loading Photos…" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" /></Border>
          </Grid>
          <Grid x:Name="ExplorePanel" Grid.Row="1" PreviewKeyDown="Explore_KeyDown">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="0">
                  <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid Margin="12,6,14,4">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /><ColumnDefinition Width="84" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                          <Button x:Name="NameHeader" Content="Name" Tag="Name" Click="TreeSort_Click" Style="{StaticResource ColumnHeader}" HorizontalContentAlignment="Left" />
                          <Button x:Name="AllocationHeader" Content="Allocated ↓" Tag="Allocated" Click="TreeSort_Click" Grid.Column="1" Style="{StaticResource ColumnHeader}" />
                          <Button x:Name="LogicalHeader" Content="Logical" Tag="Logical" Click="TreeSort_Click" Grid.Column="2" Style="{StaticResource ColumnHeader}" />
                          <Button x:Name="ShareHeader" Content="% parent" Tag="Share" Click="TreeSort_Click" Grid.Column="3" Style="{StaticResource ColumnHeader}" />
                      </Grid>
                      <ListBox x:Name="SpaceTree" Grid.Row="1" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                               SelectionChanged="Tree_Changed" PreviewKeyDown="Tree_KeyDown" PreviewMouseDown="Tree_MouseDown" MouseDoubleClick="Tree_DoubleClick" ContextMenuOpening="Tree_ContextMenuOpening"
                               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Folder and file tree. Use Left and Right to collapse and expand folders. Delete recycles the selected folder after confirmation. Right-click a folder for its operations.">
                          <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="5,0" /><Setter Property="AutomationProperties.Name" Value="{Binding Description}" /></Style></ListBox.ItemContainerStyle>
                          <ListBox.ItemTemplate>
                              <DataTemplate>
                                  <Grid MinHeight="34" ToolTip="{Binding EntryTooltip}">
                                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /><ColumnDefinition Width="84" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                                      <Grid Margin="{Binding Indent}">
                                          <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="21" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                          <Button Content="{Binding Expander}" IsEnabled="{Binding CanExpand}" Click="Expand_Click" Focusable="False" Padding="0" BorderThickness="0" Background="Transparent" MinWidth="0" MinHeight="0" AutomationProperties.Name="Expand or collapse folder" />
                                          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Opacity="0.65" Grid.Column="1" VerticalAlignment="Center" />
                                          <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Flags}" FontSize="11" Opacity="0.65"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Flags}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                      </Grid>
                                      <TextBlock Text="{Binding Allocated}" Grid.Column="1" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="{Binding SizeNote}" />
                                      <TextBlock Text="{Binding Logical}" Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                      <TextBlock Text="{Binding Share}" Grid.Column="3" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.65" />
                                  </Grid>
                              </DataTemplate>
                          </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock x:Name="TreeHint" Text="Scan a drive to explore its files." HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Margin="24" TextWrapping="Wrap" Opacity="0.65" />
                      <TextBlock x:Name="TreeNote" Text="Observed totals · Shared file allocation counted once" Grid.Row="2" Margin="12,8" FontSize="12" TextWrapping="Wrap" Opacity="0.65" />
                  </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                  <Grid x:Name="MapLayout">
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <DockPanel Margin="0,0,0,8"><TextBlock x:Name="MapTotal" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="8,0,0,0" /><WrapPanel x:Name="Breadcrumbs" VerticalAlignment="Center" /></DockPanel>
                      <local:TreemapPanel x:Name="SpaceMap" Grid.Row="1" MinHeight="120" ClipToBounds="True" AutomationProperties.Name="Framed folder treemap with one nested child level. Choose a contributor to see its files." />
                      <TextBlock x:Name="MapHint" Grid.Row="1" Text="Choose a folder to see its largest contributors." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.65" Margin="22" />
                      <WrapPanel Grid.Row="2" Margin="0,8,0,0" Opacity="0.75">
                          <StackPanel Orientation="Horizontal" Margin="0,0,12,5"><Border x:Name="ProjectSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" /><TextBlock Text="Projects &amp; data" FontSize="11" /></StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,12,5"><Border x:Name="CacheSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" /><TextBlock Text="Build &amp; cache" FontSize="11" /></StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,12,5"><Border x:Name="AgentSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" /><TextBlock Text="Agent files" FontSize="11" /></StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Border x:Name="OtherSwatch" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" /><TextBlock Text="Other" FontSize="11" /></StackPanel>
                          <TextBlock x:Name="MapBasis" Text="Area = allocated size" FontSize="11" Margin="12,0,0,5" />
                      </WrapPanel>
                      <StackPanel Grid.Row="3" x:Name="EntryDetail" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
                          <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,7" />
                          <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" FontSize="12" Padding="0" ToolTip="{Binding Path}" AutomationProperties.Name="Selected entry path" />
                          <TextBlock x:Name="EntryTypeText" Text="{Binding TypeDescription}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding TypeDescription}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                          <WrapPanel Margin="0,4,0,0"><TextBlock Text="Allocated" Opacity="0.65" FontSize="12" Margin="0,0,5,0" /><TextBlock Text="{Binding Allocated}" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" /><TextBlock Text="Logical" Opacity="0.65" FontSize="12" Margin="0,0,5,0" /><TextBlock Text="{Binding Logical}" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" /><TextBlock Text="Of parent" Opacity="0.65" FontSize="12" Margin="0,0,5,0" /><TextBlock Text="{Binding Share}" FontWeight="SemiBold" FontSize="12" /></WrapPanel>
                          <TextBlock Text="{Binding SizeNote}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" ToolTip="{Binding SizeNote}" Opacity="0.65" FontSize="11" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SizeNote}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      </StackPanel>
                  </Grid>
              </Border>
          </Grid>
          <Border x:Name="PreliminaryPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
              <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Margin="18,16">
                      <TextBlock Text="Preliminary · Largest files so far" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock x:Name="PreliminaryCaption" Text="Scanning… Folder totals and cleanup estimates will appear when ready." TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="0,6,0,0" />
                  </StackPanel>
                  <Grid Grid.Row="1" Margin="22,0,24,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                      <Button x:Name="PreliminaryNameHeader" Content="File / exact path" Tag="Name" Click="PreliminarySort_Click" Style="{StaticResource ColumnHeader}" HorizontalContentAlignment="Left" />
                      <Button x:Name="PreliminaryAllocationHeader" Content="Allocated ↓" Tag="Allocated" Click="PreliminarySort_Click" Grid.Column="1" Style="{StaticResource ColumnHeader}" />
                      <Button x:Name="PreliminaryLogicalHeader" Content="Logical" Tag="Logical" Click="PreliminarySort_Click" Grid.Column="2" Style="{StaticResource ColumnHeader}" />
                  </Grid>
                  <ListBox x:Name="PreliminaryFiles" Grid.Row="2" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                           AutomationProperties.Name="Preliminary largest files found so far">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="5,0" /><Setter Property="AutomationProperties.Name" Value="{Binding PathText}" /></Style></ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                          <DataTemplate>
                              <Grid MinHeight="54" Margin="6,0" ToolTip="{Binding EntryTooltip}">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                      <TextBlock Text="{Binding File.Name}" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.65" Margin="0,4,0,0" />
                                  </StackPanel>
                                  <TextBlock Text="{Binding Allocated}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                  <TextBlock Text="{Binding Logical}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                              </Grid>
                          </DataTemplate>
                      </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="PreliminaryHint" Grid.Row="2" Text="Waiting for file metadata…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" Margin="24" TextWrapping="Wrap" />
                  <TextBlock x:Name="PreliminaryNote" Grid.Row="3" Text="Up to 100 files · Shared file allocation counted once · Unresolved paths are marked pending" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="18,14" />
              </Grid>
          </Border>
          <Grid x:Name="OpportunitiesPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="18,16">
                        <TextBlock x:Name="OpportunityHeading" Text="Opportunities" FontSize="18" FontWeight="SemiBold" />
                    </DockPanel>
                    <ListBox x:Name="OpportunityGrid" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single" SelectionChanged="Opportunity_Changed"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Space opportunities">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="64" Margin="6,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=Select {0} for preview}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" FontSize="12" Opacity="0.65" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35">
                        <TextBlock Text="Find room for your next project." FontSize="21" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyCaption" Text="Scan a drive to review build output, caches,&#10;environments, and files left by coding agents." Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.65" />
                    </StackPanel>
                    <DockPanel Grid.Row="2" Margin="18,14">
                        <Button x:Name="ReviewButton" Content="Review selection" Click="Review_Click" DockPanel.Dock="Right" IsEnabled="False" />
                        <TextBlock x:Name="SelectionText" Text="Select locations to preview cleanup" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                    </DockPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="A closer look" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" />
                        <TextBlock x:Name="DetailHint" Text="Choose a result to see why it was found and what to check before cleanup." TextWrapping="Wrap" Opacity="0.65" />
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Category}" Opacity="0.65" FontSize="12" Margin="0,6,0,12" />
                            <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" />
                            <TextBlock Text="WHY IT WAS FOUND" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                            <TextBlock Text="BEFORE CLEANUP" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
                            <TextBlock Text="{Binding Caution}" TextWrapping="Wrap" />
                            <TextBlock Text="NEXT STEP" Style="{StaticResource SectionLabel}" Margin="0,22,0,8" />
                            <TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap" />
                            <Button Content="Open folder" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,22,0,0" />
                            <Button Content="Show in tree" Click="ShowInTree_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ExtensionJobText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,10" />
            <DockPanel>
                <Button x:Name="DetailsButton" Content="Scan details" Click="Details_Click" DockPanel.Dock="Right" Visibility="Collapsed" Padding="10,4" MinHeight="28" />
                <Button x:Name="OpenLogButton" Content="Open log" Click="OpenLog_Click" DockPanel.Dock="Right" Visibility="Collapsed" Padding="10,4" MinHeight="28" Margin="0,0,10,0" />
                <TextBlock x:Name="StatusText" Text="Ready · Scan a drive to explore space" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Opacity="0.7" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <TextBlock x:Name="BackendStatusText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
