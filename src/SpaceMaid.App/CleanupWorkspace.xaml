<UserControl x:Class="SpaceMaid.App.CleanupWorkspace"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpaceMaid.App"
             FontFamily="Segoe UI" FontSize="14">
    <UserControl.Resources>
        <Style x:Key="CleanupLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="0,6" /><Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="CleanupExpanderHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Grid Background="Transparent">
                    <Border x:Name="Hover" Background="{DynamicResource WindowForeground}" Opacity="0" CornerRadius="6" />
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    <Border x:Name="Focus" BorderBrush="{DynamicResource WindowForeground}" BorderThickness="1" CornerRadius="5" Margin="2" Opacity="0" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.05" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.1" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="0.75" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CleanupExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderToggle" Style="{StaticResource CleanupExpanderHeader}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" MinHeight="66" Padding="14,10" Background="Transparent" BorderThickness="0"
                                      AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                        <Border x:Name="ExpandedBody" Visibility="Collapsed" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,12,14,14"><ContentPresenter /></Border>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedBody" Property="Visibility" Value="Visible" /><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,14" LastChildFill="True">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back to cleanup" Style="{StaticResource CleanupLink}" Click="Back_Click" Visibility="Collapsed" Margin="0,0,18,0" />
                <Button x:Name="SavedButton" Content="Saved cleanups" Style="{StaticResource CleanupLink}" Click="Saved_Click" Margin="0,0,18,0" />
                <Button x:Name="HistoryButton" Content="History" Style="{StaticResource CleanupLink}" Click="History_Click" />
                <Button x:Name="NewButton" Content="New cleanup" Style="{StaticResource CleanupLink}" Click="New_Click" Margin="18,0,0,0" Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock Text="Cleanup" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,0,12,8">
            <StackPanel>
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="PendingButton" Style="{StaticResource CleanupLink}" Click="Saved_Click" Visibility="Collapsed" Margin="0,0,0,8" />
                <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock x:Name="RunningText" Text="Cleaning folders…" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="RunProgress" Height="4" Margin="0,10" IsIndeterminate="True" />
                    <WrapPanel><Button x:Name="StopButton" Content="Stop cleanup" Click="Stop_Click" /><Button x:Name="ViewRunningButton" Content="View run" Click="ViewRunning_Click" Style="{StaticResource CleanupLink}" Margin="18,0,0,0" Visibility="Collapsed" /><Button x:Name="PauseRunningButton" Content="Pause schedule" Click="PauseRunning_Click" Style="{StaticResource CleanupLink}" Margin="18,0,0,0" Visibility="Collapsed" /></WrapPanel>
                </StackPanel>
                <StackPanel x:Name="PlanPanel">
                    <TextBlock x:Name="DraftText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,22"><TextBlock Text="In" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="ScopeBox" MinWidth="220" MaxWidth="580" DisplayMemberPath="Label" SelectionChanged="Scope_Changed" AutomationProperties.Name="Cleanup scope" /><Button x:Name="UseCurrentScanButton" Content="Use current scan" Style="{StaticResource CleanupLink}" Click="UseCurrentScan_Click" Margin="16,0,0,0" Visibility="Collapsed" /></WrapPanel>
                    <CheckBox x:Name="BuildCheck" Content="Build outputs" IsChecked="True" FontWeight="SemiBold" Checked="Conditions_Changed" Unchecked="Conditions_Changed" />
                    <StackPanel x:Name="BuildFields" Margin="30,4,0,14">
                        <TextBlock Text="Verified rebuildable folders only" FontSize="12" Opacity="0.75" />
                        <WrapPanel Margin="0,10,0,0"><TextBlock Text="Inactive for" VerticalAlignment="Center" Margin="0,0,8,6" /><TextBox x:Name="DaysBox" Text="30" Width="100" MaxLength="3" TextChanged="Conditions_Changed" AutomationProperties.Name="Build inactivity in days" Margin="0,0,8,6" /><TextBlock Text="days" VerticalAlignment="Center" Margin="0,0,18,6" /><ComboBox x:Name="ActionBox" Width="235" SelectedIndex="0" SelectionChanged="Conditions_Changed" AutomationProperties.Name="Build removal policy" Margin="0,0,0,6"><ComboBoxItem Content="Recycle" /><ComboBoxItem Content="Delete builds permanently" /></ComboBox></WrapPanel>
                    </StackPanel>
                    <Expander x:Name="MoreOptions" Style="{StaticResource CleanupExpander}" AutomationProperties.Name="More cleanup options">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel Grid.Column="1"><TextBlock Text="More cleanup options" FontWeight="SemiBold" /><TextBlock x:Name="OptionsSummary" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></Grid></Expander.Header>
                        <StackPanel>
                            <CheckBox x:Name="CacheCheck" Content="Package caches" Checked="Conditions_Changed" Unchecked="Conditions_Changed" />
                            <TextBlock Text="Recycle eligible folders; tool-managed stores stay protected." FontSize="12" Opacity="0.75" Margin="28,4,0,14" TextWrapping="Wrap" />
                            <CheckBox x:Name="WorktreeCheck" Content="Worktrees" Checked="Conditions_Changed" Unchecked="Conditions_Changed" />
                            <StackPanel x:Name="WorktreeFields" Margin="28,8,0,12" Visibility="Collapsed"><WrapPanel><ComboBox x:Name="WorktreeRuleBox" MinWidth="190" SelectedIndex="0" SelectionChanged="Conditions_Changed" AutomationProperties.Name="Worktree cleanup condition" Margin="0,0,12,6"><ComboBoxItem Content="Old and integrated" /><ComboBoxItem Content="Old clean worktrees" /><ComboBoxItem Content="Integrated, any age" /></ComboBox><TextBlock Text="Inactive for" VerticalAlignment="Center" Margin="0,0,8,6" /><TextBox x:Name="WorktreeDaysBox" Width="100" Text="30" MaxLength="3" TextChanged="Conditions_Changed" AutomationProperties.Name="Worktree inactivity in days" Margin="0,0,8,6" /><TextBlock Text="days" VerticalAlignment="Center" Margin="0,0,0,6" /></WrapPanel><TextBlock Text="Local changes and ignored files stay protected. Branches stay kept." FontSize="12" Opacity="0.75" TextWrapping="Wrap" /></StackPanel>
                            <Expander Header="Folder exclusions" Margin="0,10,0,8" AutomationProperties.Name="Folder exclusions"><StackPanel Margin="0,8,0,0"><TextBlock Text="One path per line" FontSize="12" Opacity="0.75" /><TextBox x:Name="ExclusionsBox" AcceptsReturn="True" MinHeight="72" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextChanged="Conditions_Changed" AutomationProperties.Name="Excluded folder paths" /></StackPanel></Expander>
                            <Expander x:Name="OtherRulesGroup" Header="Other cleanup rules" Margin="0,6,0,8" Visibility="Collapsed" AutomationProperties.Name="Other cleanup rules"><StackPanel x:Name="OtherRulesPanel" Margin="0,8,0,0" /></Expander>
                            <Button x:Name="BrowseButton" Content="Browse all cleanup types" Style="{StaticResource CleanupLink}" Click="Browse_Click" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Margin="0,24,0,12"><TextBlock x:Name="EstimateCaption" Text="Estimated data to recycle" FontSize="12" Opacity="0.75" /><TextBlock x:Name="EstimateText" Text="Scan a location first" FontSize="32" FontWeight="SemiBold" Margin="0,2,0,6" /><WrapPanel><TextBlock x:Name="ReadyText" VerticalAlignment="Center" FontSize="13" Opacity="0.8" Margin="0,0,14,0" /><Button x:Name="KeptButton" Style="{StaticResource CleanupLink}" Click="Kept_Click" /></WrapPanel><TextBlock x:Name="FreshnessText" FontSize="12" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                    <TextBlock x:Name="PermanentText" Text="Builds will be permanently deleted, with no recovery. Other selected types recycle." Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><WrapPanel><Button x:Name="InspectButton" Content="Inspect folders" Style="{StaticResource CleanupLink}" Click="Inspect_Click" /><Button x:Name="UpdateEstimateButton" Content="Update estimate" Style="{StaticResource CleanupLink}" Click="UpdateEstimate_Click" Margin="18,0,0,0" Visibility="Collapsed" /></WrapPanel><Button x:Name="CleanupButton" Grid.Column="1" Content="Recycle folders" MinWidth="185" Padding="16,9" Style="{DynamicResource AccentButtonStyle}" Click="Cleanup_Click" IsEnabled="False" /></Grid>
                    <Expander x:Name="SaveOptions" Style="{StaticResource CleanupExpander}" Expanded="SaveExpansion_Changed" Collapsed="SaveExpansion_Changed" AutomationProperties.Name="Save and schedule cleanup">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel Grid.Column="1"><TextBlock Text="Save &amp; schedule" FontWeight="SemiBold" /><TextBlock x:Name="ScheduleSummary" Text="Not saved · Run manually" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></Grid></Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Name" FontSize="12" Opacity="0.75" Margin="0,0,0,5" /><TextBox x:Name="NameBox" Text="Build cleanup" MaxLength="80" MaxWidth="460" HorizontalAlignment="Left" MinWidth="250" TextChanged="SaveFields_Changed" AutomationProperties.Name="Saved cleanup name" />
                            <WrapPanel Margin="0,14,0,0"><TextBlock Text="When" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="FrequencyBox" SelectedIndex="0" MinWidth="170" SelectionChanged="SaveFields_Changed" AutomationProperties.Name="Cleanup frequency"><ComboBoxItem Content="When I run it" /><ComboBoxItem Content="Every week" /></ComboBox></WrapPanel>
                            <StackPanel x:Name="WeeklyFields" Visibility="Collapsed" Margin="0,12,0,0"><WrapPanel><ComboBox x:Name="WeekdayBox" MinWidth="150" SelectionChanged="SaveFields_Changed" AutomationProperties.Name="Cleanup weekday" Margin="0,0,10,6" /><TextBox x:Name="TimeBox" Text="09:00" Width="110" MaxLength="5" TextChanged="SaveFields_Changed" AutomationProperties.Name="Scheduled time, hours and minutes" Margin="0,0,10,6" /><TextBlock x:Name="TimeZoneText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,0,6" /><Button x:Name="UsePcZoneButton" Content="Use this PC's time zone" Style="{StaticResource CleanupLink}" Click="UsePcZone_Click" Visibility="Collapsed" /></WrapPanel>
                                <RadioButton x:Name="AskFirstRadio" GroupName="CleanupScheduleMode" IsChecked="True" Content="Ask me first" Margin="0,8,0,4" Checked="SaveFields_Changed" /><RadioButton x:Name="AutomaticRadio" GroupName="CleanupScheduleMode" Content="Clean automatically" Margin="0,4,0,4" Checked="SaveFields_Changed" />
                                <TextBlock x:Name="AutomaticHint" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="24,4,0,8" />
                                <Expander Header="Run limits and schedule details" FontSize="12" Margin="0,8,0,0"><StackPanel Margin="0,8,0,0"><WrapPanel><TextBlock Text="At most" VerticalAlignment="Center" Margin="0,0,8,6" /><TextBox x:Name="LimitGiBBox" Text="10" Width="100" TextChanged="SaveFields_Changed" AutomationProperties.Name="Maximum GiB per automatic run" Margin="0,0,8,6" /><TextBlock Text="GiB and" VerticalAlignment="Center" Margin="0,0,8,6" /><TextBox x:Name="LimitTargetsBox" Text="500" Width="110" TextChanged="SaveFields_Changed" AutomationProperties.Name="Maximum folders per automatic run" Margin="0,0,8,6" /><TextBlock Text="folders per run" VerticalAlignment="Center" Margin="0,0,0,6" /></WrapPanel><TextBlock Text="Runs while this PC is awake and you are signed in. Missed runs stay missed. Pausing affects future runs; Stop ends the current run." TextWrapping="Wrap" Opacity="0.75" /></StackPanel></Expander>
                            </StackPanel>
                            <TextBlock x:Name="ScheduleConsent" TextWrapping="Wrap" Margin="0,14,0,12" Visibility="Collapsed" />
                            <Button x:Name="SaveButton" Content="Save cleanup" HorizontalAlignment="Left" Click="Save_Click" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed"><TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ResultPolicy" TextWrapping="Wrap" Margin="0,8,0,18" /><TextBlock x:Name="ResultHeadline" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="ResultSummary" TextWrapping="Wrap" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite" /><WrapPanel><Button x:Name="InspectResultsButton" Content="Inspect results" Style="{StaticResource CleanupLink}" Click="Inspect_Click" /><Button x:Name="ReviewRemainingButton" Content="Review remaining" Style="{StaticResource CleanupLink}" Click="Remaining_Click" Margin="18,0,0,0" Visibility="Collapsed" /></WrapPanel><WrapPanel Margin="0,18,0,10"><Button x:Name="DoneButton" Content="Done" Click="Back_Click" /><Button x:Name="ApprovePendingButton" Content="Run cleanup" Click="Cleanup_Click" Visibility="Collapsed" Margin="12,0,0,0" /><Button x:Name="DismissPendingButton" Content="Dismiss review" Style="{StaticResource CleanupLink}" Click="Dismiss_Click" Visibility="Collapsed" Margin="18,0,0,0" /></WrapPanel></StackPanel>
                <StackPanel x:Name="LibraryPanel" Visibility="Collapsed" />
                <Border x:Name="InspectorHost" Visibility="Collapsed" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0" />
                <Expander x:Name="DiagnosticsPanel" Header="Diagnostics" Visibility="Collapsed" Margin="0,18,0,0"><StackPanel><CheckBox x:Name="IncludePathsCheck" Content="Include full paths" Checked="ReportOptions_Changed" Unchecked="ReportOptions_Changed" Margin="0,8" /><TextBox x:Name="ReportBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Cleanup diagnostic report" /><Button Content="Copy report" HorizontalAlignment="Left" Click="CopyReport_Click" Margin="0,8,0,0" /></StackPanel></Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
