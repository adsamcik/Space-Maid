<Window x:Class="SpaceMaid.App.ScanDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan details" Width="700" Height="710" MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Scan details" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="BackendText" FontSize="18" FontWeight="SemiBold" />
                <TextBox x:Name="TargetText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,6,0,12" />
                <TextBlock x:Name="FallbackText" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16" />
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="CountsText" TextWrapping="Wrap" Margin="0,0,0,7" />
                        <TextBlock x:Name="ThroughputText" TextWrapping="Wrap" Margin="0,0,0,7" />
                        <TextBlock x:Name="MemoryText" TextWrapping="Wrap" Margin="0,0,0,7" />
                        <TextBlock x:Name="CoverageText" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Text="PHASE TIMINGS" Style="{StaticResource SectionLabel}" Margin="0,20,0,10" />
                <StackPanel x:Name="PhaseList" />
                <TextBlock x:Name="TotalText" FontWeight="SemiBold" Margin="0,5,0,16" />
                <TextBlock Text="COVERAGE &amp; ACCOUNTING" Style="{StaticResource SectionLabel}" />
                <TextBlock x:Name="AccountingText" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,15" />
                <TextBlock x:Name="WarningHeading" Style="{StaticResource SectionLabel}" />
                <ItemsControl x:Name="WarningList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Process peak is the lifetime high-water mark. Managed allocations show allocation traffic during scanning, not retained memory. Explorer preparation excludes completed UI rendering." TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
        <Button Content="Close" IsCancel="True" Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="90" />
    </Grid>
</Window>
