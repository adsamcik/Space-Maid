<Window x:Class="SpaceMaid.App.OnlineOnlyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make online-only" Width="550" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="20">
        <TextBlock Text="Make online-only?" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="TargetPath" IsReadOnly="True" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.Name="Exact online-only location" />
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="24" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="ProviderText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="PlanText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Cloud copies stay. Internet and your sync app are needed to download again. Unsynced files are skipped." Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" />
        <Expander Header="Details" Margin="0,10,0,0">
            <TextBlock Text="Clears ‘Always keep on this device’. Your sync app releases space, which may take time. Cancellation stops new requests; earlier requests remain active." Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
        </Expander>
        <TextBlock x:Name="WarningsText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Keep offline" IsCancel="True" IsDefault="True" Margin="0,0,10,0" />
            <Button x:Name="ConfirmButton" Content="Make online-only" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
