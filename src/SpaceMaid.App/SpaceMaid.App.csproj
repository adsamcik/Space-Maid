<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/branding/space-maid-visor.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <BundledExtension Include="../SpaceMaid.Extensions.Photos/SpaceMaid.Extensions.Photos.csproj" ExtensionId="space-maid.photos" />
    <BundledExtension Include="../SpaceMaid.Extensions.Apps/SpaceMaid.Extensions.Apps.csproj" ExtensionId="space-maid.apps" />
    <BundledExtension Include="../SpaceMaid.Extensions.Developer/SpaceMaid.Extensions.Developer.csproj" ExtensionId="space-maid.developer" />
    <BundledExtension Include="../SpaceMaid.Extensions.Assistant/SpaceMaid.Extensions.Assistant.csproj" ExtensionId="space-maid.assistant" />
    <Resource Include="../../assets/branding/space-maid-visor.ico" Link="Assets/SpaceMaid.ico" />
    <Content Include="../../LICENSE;../../THIRD_PARTY_NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceMaid.Core/Analysis/Data/README.md" Link="Notices/FileFormatRegistry/README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../SpaceMaid.Core/Analysis/Data/FileFormatRegistry.provenance.json.gz" Link="Notices/FileFormatRegistry/FileFormatRegistry.provenance.json.gz" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../SpaceMaid.Core/SpaceMaid.Core.csproj" />
    <ProjectReference Include="../SpaceMaid.Extensions.Contracts/SpaceMaid.Extensions.Contracts.csproj" />
    <ProjectReference Include="../SpaceMaid.ScanHelper/SpaceMaid.ScanHelper.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- Bundle extension files explicitly; do not propagate their manifests to the app root. -->
    <ProjectReference Include="@(BundledExtension)" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../SpaceMaid.ModelWorker/SpaceMaid.ModelWorker.csproj" ReferenceOutputAssembly="false" Private="false" />
    <InternalsVisibleTo Include="SpaceMaid.Tests" />
  </ItemGroup>
  <Target Name="CopyScanHelper" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="../SpaceMaid.ScanHelper/SpaceMaid.ScanHelper.csproj" Targets="Build;GetTargetPath" Properties="Configuration=$(Configuration);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="HelperTarget" />
    </MSBuild>
    <ItemGroup>
      <HelperFiles Include="%(HelperTarget.RootDir)%(HelperTarget.Directory)SpaceMaid.ScanHelper.*;%(HelperTarget.RootDir)%(HelperTarget.Directory)SpaceMaid.Core.dll" />
      <Content Include="@(HelperFiles)" Link="ScanHelper/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="CopyBundledExtensions" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="%(BundledExtension.Identity)" Targets="Build;GetTargetPath" Properties="Configuration=$(Configuration);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="BundledExtensionTargetOutputs" />
    </MSBuild>
    <!-- TargetOutputs identify their source project; attach its declared bundle ID. -->
    <JoinItems Left="@(BundledExtensionTargetOutputs->Distinct())" LeftKey="MSBuildSourceProjectFile" LeftMetadata="*"
               Right="@(BundledExtension)" RightKey="FullPath" RightMetadata="ExtensionId" ItemSpecToUse="Left">
      <Output TaskParameter="JoinResult" ItemName="BundledExtensionTargets" />
    </JoinItems>
    <ItemGroup>
      <BundledExtensionFiles Include="%(BundledExtensionTargets.RootDir)%(BundledExtensionTargets.Directory)**/*"
                             Exclude="%(BundledExtensionTargets.RootDir)%(BundledExtensionTargets.Directory)SpaceMaid.Extensions.Contracts.*;%(BundledExtensionTargets.RootDir)%(BundledExtensionTargets.Directory)SpaceMaid.Core.*">
        <ExtensionId>%(BundledExtensionTargets.ExtensionId)</ExtensionId>
      </BundledExtensionFiles>
      <Content Include="@(BundledExtensionFiles)" Link="Extensions/%(BundledExtensionFiles.ExtensionId)/%(BundledExtensionFiles.RecursiveDir)%(BundledExtensionFiles.Filename)%(BundledExtensionFiles.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="CopyAssistantWorker" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="../SpaceMaid.ModelWorker/SpaceMaid.ModelWorker.csproj" Targets="GetPublishedWorkerDirectory" Properties="Configuration=$(Configuration);ArtifactsPath=$(ArtifactsPath)" RemoveProperties="PublishDir;PublishUrl">
      <Output TaskParameter="TargetOutputs" ItemName="WorkerPublish" />
    </MSBuild>
    <ItemGroup>
      <WorkerFiles Include="%(WorkerPublish.Identity)/**/*" />
      <Content Include="@(WorkerFiles)" Link="Extensions/space-maid.assistant/Worker/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
