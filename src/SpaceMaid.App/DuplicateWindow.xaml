<Window x:Class="SpaceMaid.App.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicates and storage" Width="1060" Height="760" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <DockPanel>
                <Button x:Name="FindButton" Content="Find duplicates" Click="Find_Click" DockPanel.Dock="Right" Padding="14,5"/>
                <Button x:Name="InspectButton" Content="Inspect build file…" Click="Inspect_Click" DockPanel.Dock="Right" Padding="12,5" Margin="0,0,7,0"/>
                <TextBlock x:Name="ScopeText" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
            <TextBlock Text="Compare exact file contents. Files and their paths stay in place." Margin="0,6,0,8" TextWrapping="Wrap"/>
            <Expander Header="Search limits and excluded locations" Margin="0,0,0,8">
                <StackPanel x:Name="OptionsPanel">
                    <WrapPanel Margin="0,4,0,8">
                        <TextBlock Text="Minimum size" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBox x:Name="MinimumBox" Text="64" Width="64" AutomationProperties.Name="Minimum file size in KiB"/>
                        <TextBlock Text="KiB" VerticalAlignment="Center" Margin="6,0,20,0"/>
                        <TextBlock Text="Read limit" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBox x:Name="ReadLimitBox" Text="1024" Width="70" AutomationProperties.Name="Maximum content read in MiB"/>
                        <TextBlock Text="MiB · 30 seconds · 20,000 files per page" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <TextBox x:Name="ExclusionsBox" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Excluded absolute locations, one per line" ToolTip="One absolute file or folder per line. Folder contents are excluded too."/>
                </StackPanel>
            </Expander>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="ContinueButton" Content="Next page" Click="Continue_Click" DockPanel.Dock="Right" IsEnabled="False" Padding="12,4"/>
            <TextBlock x:Name="SummaryText" Text="Choose Find duplicates to compare this scanned location." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="GroupList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" SelectionChanged="Group_Changed">
                <DataGrid.Columns><DataGridTextColumn Header="Copies" Binding="{Binding Count}" Width="65"/><DataGridTextColumn Header="Per file" Binding="{Binding Size}" Width="90"/><DataGridTextColumn Header="Redundant content" Binding="{Binding Redundancy}" Width="*"/></DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid x:Name="FileList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" SelectionChanged="File_Changed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" ClipboardContentBinding="{Binding Path}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="Data" Binding="{Binding DataStatus}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock x:Name="DetailText" Text="Select a group and file to inspect storage options." TextWrapping="Wrap" MaxHeight="76" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RevealButton" Content="Show in Explorer" Click="Reveal_Click" IsEnabled="False" Margin="0,0,7,0" Padding="10,5"/>
                        <Button x:Name="CompressButton" Content="Compress selected" Click="Compress_Click" IsEnabled="False" Margin="0,0,7,0" Padding="10,5"/>
                        <Button x:Name="DecompressButton" Content="Undo compression" Click="Decompress_Click" IsEnabled="False" Margin="0,0,7,0" Padding="10,5"/>
                        <Button x:Name="ShareButton" Content="Share ReFS blocks" Click="Share_Click" IsEnabled="False" Padding="10,5"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar x:Name="WorkProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8"/>
            <DockPanel>
                <Button x:Name="CloseButton" Content="Close" Click="Close_Click" DockPanel.Dock="Right" Padding="14,5" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Text="Redundant content is not guaranteed physical recovery. Shared objects are counted once." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
