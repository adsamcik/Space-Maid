<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Launch-only process package; no worker assembly is loaded by the app. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SpaceMaid.LocalModel/ModelProtocol.cs" Link="ModelProtocol.cs" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <!-- Update the runtime dependencies beyond LLamaSharp's minimum versions. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.14" />
  </ItemGroup>
  <Target Name="IncludeRuntimeLicenseNotices" AfterTargets="ResolveFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_WorkerRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_WorkerRuntimeNotice Include="%(_WorkerRuntimePack.PackageDirectory)/LICENSE.TXT;%(_WorkerRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT" />
    </ItemGroup>
    <Error Condition="'@(_WorkerRuntimePack)' == ''" Text="The worker's runtime package could not be resolved for license attribution." />
    <Error Condition="!Exists('%(_WorkerRuntimeNotice.Identity)')" Text="Missing runtime license notice: %(_WorkerRuntimeNotice.Identity)" />
    <ItemGroup>
      <Content Include="@(_WorkerRuntimeNotice)" Link="Runtime-%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="GetPublishedWorkerDirectory" DependsOnTargets="Publish" Returns="@(_WorkerPublishedDirectory)">
    <ItemGroup><_WorkerPublishedDirectory Include="$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))" /></ItemGroup>
  </Target>
</Project>
