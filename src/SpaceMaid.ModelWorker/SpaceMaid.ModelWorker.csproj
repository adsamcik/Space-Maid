<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Launch-only process package; no worker assembly is loaded by the app. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SpaceMaid.LocalModel/ModelProtocol.cs" Link="ModelProtocol.cs" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>
  <Target Name="GetPublishedWorkerDirectory" DependsOnTargets="Publish" Returns="@(_WorkerPublishedDirectory)">
    <ItemGroup><_WorkerPublishedDirectory Include="$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))" /></ItemGroup>
  </Target>
</Project>
