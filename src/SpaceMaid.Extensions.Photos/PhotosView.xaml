<UserControl x:Class="SpaceMaid.Extensions.Photos.PhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <UserControl.Resources>
        <Style x:Key="PhotoHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="FontWeight" Value="Normal" /><Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="8,10" />
        </Style>
        <Style x:Key="PhotoCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="CollectionHeader" Visibility="Collapsed" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="CollectionList" Width="240" SelectionChanged="Collection_Changed" AutomationProperties.Name="Photo collection" ToolTip="Choose a photo collection">
                <ComboBox.ItemTemplate><DataTemplate>
                    <DockPanel LastChildFill="True" ToolTip="{Binding Root}">
                        <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" DockPanel.Dock="Right" FontSize="12" Opacity="0.65" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="AddButton" Grid.Column="1" Content="Add folder" Click="Add_Click" Margin="8,0,0,0" Padding="10,5" AutomationProperties.Name="Add photo collection folder" />
            <TextBlock x:Name="CollectionPathText" Grid.Column="2" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Padding="10,5" ToolTip="Update filenames and metadata without reading photo contents." IsEnabled="False" />
                <Button x:Name="AnalyzeButton" Content="Analyze photos" Click="Analyze_Click" Padding="14,5" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" ToolTip="Read this collection's files to inspect metadata, find exact duplicates and enable previews. Originals stay untouched." IsEnabled="False" />
            </StackPanel>
        </Grid>
        <Grid x:Name="StatusBand" Grid.Row="1" Height="32" Visibility="Collapsed" Margin="0,0,0,6">
            <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="4" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Visibility="Hidden" MinHeight="24" Padding="10,1" />
            <ProgressBar x:Name="JobProgress" Grid.Row="1" Grid.ColumnSpan="2" Height="2" Visibility="Hidden" IsIndeterminate="True" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,0,14,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel x:Name="ModeBar" LastChildFill="True" Visibility="Collapsed" Margin="0,4,0,8">
                        <TextBlock x:Name="ReviewOnlyLabel" Text="Review only" DockPanel.Dock="Right" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Photo cleanup and conversion are disabled. Originals remain untouched." />
                        <TextBlock x:Name="FreshnessText" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BrowseTab" GroupName="PhotoMode" Content="Browse" IsChecked="True" Checked="Mode_Changed" Style="{DynamicResource ViewTab}" />
                            <RadioButton x:Name="DuplicatesTab" GroupName="PhotoMode" Content="Duplicates" Checked="Mode_Changed" Style="{DynamicResource ViewTab}" Margin="22,0,0,0" />
                            <RadioButton x:Name="FamiliesTab" GroupName="PhotoMode" Content="Related files" Checked="Mode_Changed" Style="{DynamicResource ViewTab}" Margin="22,0,0,0" ToolTip="Possible RAW, image and sidecar relationships" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="FileList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0" ColumnHeaderStyle="{StaticResource PhotoHeader}"
                                  SelectionMode="Single" SelectionUnit="FullRow" Sorting="Files_Sorting" SelectionChanged="File_Changed" LoadingRow="File_LoadingRow"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="56" HeadersVisibility="Column" GridLinesVisibility="None"
                                  Visibility="Collapsed" AutomationProperties.Name="Paged photo file list">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="GroupColumn" Header="Group" Binding="{Binding Row.GroupText}" ElementStyle="{StaticResource PhotoCellText}" SortMemberPath="Group" Width="125" Visibility="Collapsed" />
                                <DataGridTemplateColumn Header="" Width="56" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Grid Width="46" Height="42" ToolTip="{Binding PreviewStatus}" AutomationProperties.Name="{Binding Row.Name}" AutomationProperties.HelpText="{Binding PreviewStatus}">
                                            <Image Source="{Binding Preview}" Stretch="Uniform" />
                                            <TextBlock x:Name="PreviewPlaceholder" Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                        <DataTemplate.Triggers><DataTrigger Binding="{Binding Preview}" Value="{x:Null}"><Setter TargetName="PreviewPlaceholder" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="*" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Margin="8,0" VerticalAlignment="Center" ToolTip="{Binding LocationHint}">
                                            <TextBlock Text="{Binding Row.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Size" Binding="{Binding Row.SizeText}" ElementStyle="{StaticResource PhotoCellText}" SortMemberPath="Size" Width="88" />
                                <DataGridTextColumn x:Name="TypeColumn" Header="Type" Binding="{Binding Row.TypeText}" ElementStyle="{StaticResource PhotoCellText}" SortMemberPath="Type" Width="110" Visibility="Collapsed" />
                                <DataGridTextColumn x:Name="CapturedColumn" Header="Captured" Binding="{Binding Row.Captured, TargetNullValue=—}" ElementStyle="{StaticResource PhotoCellText}" SortMemberPath="Captured" Width="126" />
                                <DataGridTextColumn x:Name="StatusColumn" Header="Status" Binding="{Binding Row.Status}" ElementStyle="{StaticResource PhotoCellText}" SortMemberPath="Status" Width="200" Visibility="Collapsed" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid x:Name="EmptyPanel" Margin="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="36" Opacity="0.35" HorizontalAlignment="Center" Margin="0,0,0,18" />
                                <TextBlock x:Name="EmptyTitle" Text="Add your first photo folder" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.65" Margin="0,10,0,0" Visibility="Collapsed" />
                                <Button x:Name="EmptyActionButton" Content="Add folder" Click="EmptyAction_Click" HorizontalAlignment="Center" Padding="18,6" Margin="0,18,0,0" Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <DockPanel x:Name="PageFooter" Grid.Row="2" Margin="0,8,0,0" LastChildFill="True" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Columns" Click="Columns_Click" Padding="8,4" MinHeight="28" ToolTip="Choose additional file columns" Margin="0,0,8,0">
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem x:Name="ShowTypeColumn" Header="Type" IsCheckable="True" Click="Column_Changed" />
                                    <MenuItem x:Name="ShowCapturedColumn" Header="Captured" IsCheckable="True" IsChecked="True" Click="Column_Changed" />
                                    <MenuItem x:Name="ShowStatusColumn" Header="Status" IsCheckable="True" Click="Column_Changed" />
                                </ContextMenu></Button.ContextMenu>
                            </Button>
                            <StackPanel x:Name="PageButtons" Orientation="Horizontal" Visibility="Collapsed">
                                <Button x:Name="PreviousButton" Content="Previous" Click="Previous_Click" Padding="10,4" MinHeight="28" IsEnabled="False" />
                                <Button x:Name="NextButton" Content="Next" Click="Next_Click" Padding="10,4" MinHeight="28" Margin="6,0,0,0" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" FontSize="12" Opacity="0.65" />
                    </DockPanel>
                </Grid>
            </Border>
            <Border x:Name="SelectionPanel" Grid.Column="1" Width="300" Margin="12,0,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <Button x:Name="CloseSelectionButton" Content="×" Click="CloseSelection_Click" DockPanel.Dock="Right" MinWidth="32" MinHeight="32" Padding="6,0" Margin="8,0,0,0" ToolTip="Close file details" AutomationProperties.Name="Close file details" />
                        <TextBlock x:Name="SelectedNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Height="160" Margin="0,0,0,8">
                                <Image x:Name="SelectedPreview" MaxWidth="160" Height="160" Stretch="Uniform" HorizontalAlignment="Center" Visibility="Hidden" AutomationProperties.Name="Selected photo preview" />
                                <TextBlock x:Name="SelectedPreviewPlaceholder" Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="36" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="PreviewStatusText" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock x:Name="SelectedSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox x:Name="SelectedPathText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" Margin="0,10,0,14" AutomationProperties.Name="Selected photo exact path" />
                            <Expander x:Name="FileDetails" Header="File details" FontSize="12">
                                <TextBox x:Name="SelectionText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,10,0,0" AutomationProperties.Name="Selected photo evidence" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="RevealButton" Content="Open in File Explorer" Click="Reveal_Click" IsEnabled="False" />
                        <Button x:Name="RetainButton" Content="Mark to keep" Click="Retain_Click" Visibility="Collapsed" Margin="0,8,0,0" ToolTip="Review preference only. Does not delete or modify any file." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Expander x:Name="CollectionDetails" Grid.Row="3" Header="Collection details" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid Margin="0,8,0,0" MaxHeight="140">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="CoverageText" TextWrapping="Wrap" Opacity="0.7" /></ScrollViewer>
                <TextBlock x:Name="ToolText" Grid.Row="1" Opacity="0.65" Margin="0,6,0,0" TextWrapping="Wrap" />
            </Grid>
        </Expander>
    </Grid>
</UserControl>
